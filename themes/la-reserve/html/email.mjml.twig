<mjml>
	<mj-head>
	  <mj-style inline="inline">
		mj-text {
		font-size: 16px;
		}
		p, li {margin:0 !important; padding:0; line-height:1.4em; font-family:Arial, Helvetica, sans-serif;}
		/*
		need this reset to avoid border on column + on nested table
		showing separately (double border)
		when user sets a border using the UI
		This is for the Builder UI only, because in the output,
		you only get the one from the table element anyway.
		but the builder (for whatever reason) sets the border on the mj-column itself + the nested table
		Note: don't reset the padding, you need it in order to hover on the column
		*/
		.gjs-dashed *[data-highlightable][data-gjs-type="mj-column"] {
		border: 0 none !important;
		}

	  </mj-style>
