        width: 100%;
        font-size: inherit;
        font-family: inherit;
        padding: 15px 18px;
        border: 1px solid var(--form-border-strong);
        background-color: var(--form-field);
        box-shadow: none;
        border-radius: 0px;
        box-sizing: border-box;
        outline: 4px solid transparent;
        outline-offset: 6px;
        transition: var(--form-transition-all-productive);
    }

