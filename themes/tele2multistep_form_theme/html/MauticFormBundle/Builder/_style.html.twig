        margin-top: 12px;
    }

    .mauticform-row:has(.mauticform-errormsg[aria-hidden="false"]) .mauticform-helpmessage {
        display: none;
    }

    .mauticform-errormsg {
        display: block;
        color: var(--form-support-error);
        margin-top: 12px;
    }

    .mauticform-selectbox,
