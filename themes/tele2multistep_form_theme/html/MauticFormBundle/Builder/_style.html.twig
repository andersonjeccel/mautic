        --form-interactive: var(--form-primary-60);
        --form-highlight: var(--form-primary-20);

        --form-duration-productive: 150ms;
        --form-duration-expressive: 300ms;

        --form-easing-standard-productive: cubic-bezier(0.2, 0, 0.38, 0.9);
