    .mauticform_wrapper {
        max-width: 600px;
        margin: 20px;
        font-family: 'Tele2 Sans', Arial, Helvetica, sans-serif;
        font-size: 16px;
        width: 100%;
    }

    .mauticform-innerform {}

    .mauticform-post-success {}

