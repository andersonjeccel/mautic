        --form-layer-hover: #cccccc33;
        --form-layer-alternate: #ffffff;
        --form-layer-alternate-hover: #e8e8e8;
        --form-layer-selected-inverse: #292435;

        --form-field: var(--form-layer);
        --form-field-hover: var(--form-layer-hover);

        --form-border-interactive: var(--form-primary-60);
        --form-border-subtle: #e0e0e0;
        --form-border-strong: #747371;
        --form-border-strong-hover: #1a1a1a;
        --form-border-inverse: #161616;
