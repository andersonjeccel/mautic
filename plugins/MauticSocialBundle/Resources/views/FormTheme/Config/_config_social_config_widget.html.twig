{% block _config_social_config_widget %}
<div class="card border-primary">
    <div class="card-header">
        <h3 class="card-title">{{ 'mautic.config.tab.social_config'|trans }}</h3>
    </div>
    <div class="card-body">
        {% for f in form.children %}
            <div class="row">
                <div class="col-md-6">
                    {{ form_row(f) }}
                </div>
            </div>
        {% endfor %}
    </div>
</div>
{% endblock %}
