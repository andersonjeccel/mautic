{% set isIndex = tmpl == 'index' ? true : false %}
{% set tmpl = 'list' %}

{% extends isIndex ? '@MauticCore/Default/content.html.twig' : '@MauticCore/Default/raw_output.html.twig' %}
{% block headerTitle %}{% trans %}mautic.tagmanager.tag.header.index{%  endtrans %}{% endblock %}
{% block mauticContent %}tags{% endblock %}


{% if nameGetter is not defined %}
    {% set nameGetter = 'getTag' %}
{% endif %}

{% set listCommand = 'mautic.tagmanager.tag.searchcommand.list'|trans %}

{% block content %}
  {% if isIndex %}
    <div id="page-list-wrapper" class="{% if items|length > 0 or searchValue is not empty %}panel {% endif %}panel-default">
        {{- include('@MauticCore/Helper/list_toolbar.html.twig', {
            'searchValue': searchValue,
            'action': currentRoute,
            'page_actions': {
                'templateButtons': {
                    'new': security.isGranted('tagManager:tagManager:create')
                },
                'routeBase': 'tagmanager',
                'langVar': 'tag.list'
            },
            'bulk_actions': {
                'langVar': 'tagmanager.tag',
                'routeBase': 'tagmanager',
                'templateButtons': {
                    'delete': permissions['tagManager:tagManager:delete'],
                },
            },
            'quickFilters': {
                'mautic.core.quick_filters.others': {
                    'filters': [
                        {
                            'search': 'mautic.lead.tag.searchcommand.hascontacts',
                            'label': 'mautic.tagmanager.search.quickfilter.has_contacts',
                            'tooltip': 'mautic.lead.tag.searchcommand.hascontacts.description',
                            'icon': 'ri-user-follow-line'
                        },
                        {
                            'search': 'mautic.lead.tag.searchcommand.unused',
                            'label': 'mautic.tagmanager.search.quickfilter.unused',
                            'tooltip': 'mautic.lead.tag.searchcommand.unused.description',
                            'icon': 'ri-user-unfollow-line'
                        }
                    ],
                }
            }
        }) -}}
        <div class="page-list">
  {% endif %}

  {{ include('@MauticTagManager/Tag/_list.html.twig') }}

  {% if isIndex %}
        </div>
    </div>

    {{ include('@MauticCore/Modules/protip.html.twig', {
        tip: random(['mautic.protip.tags.segmentation', 'mautic.protip.tags.multivalue', 'mautic.protip.tags.creation'])
    }) }}
  {% endif %}
{% endblock %}