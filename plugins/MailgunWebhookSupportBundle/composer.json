{
    "name": "dropsolid/mailgun-webhook-support",
    "description": "Mailgun Webhook Support Plugin",
    "type": "mautic-plugin",
    "keywords": [
        "mautic",
        "plugin",
        "integration"
    ],
    "extra": {
        "install-directory-name": "MailgunWebhookSupportBundle"
    },
    "require": {
        "mautic/core-lib": "^5.2"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.0",
        "phpstan/phpstan": "^2.1",
        "phpstan/phpstan-deprecation-rules": "^2.0"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "repositories": [
        {
            "type": "git",
            "url": "https://github.com/mautic/FOSOAuthServerBundle.git"
        },
        {
            "type": "git",
            "url": "https://github.com/mautic/SpBundle.git"
        },
        {
            "type": "git",
            "url": "https://github.com/mautic/SymfonyBridgeBundle.git"
        }
    ]
} 