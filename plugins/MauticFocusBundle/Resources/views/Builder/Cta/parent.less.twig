.mf-cta-iframe {
    position: fixed;
    z-index: 21001;
    margin-top: -100%;

    &.mf-loaded {
        margin-top: 0;
        margin-bottom: 0;

        &.mf-cta-iframe-top-left {
            top: 5px;
            left: 5px;
        }

        &.mf-cta-iframe-top-right {
            top: 5px;
            right: 5px;
        }

        &.mf-cta-iframe-bottom-left {
            bottom: 5px;
            left: 5px;
        }

        &.mf-cta-iframe-bottom-right {
            bottom: 5px;
            right: 5px;
        }

        &.mf-responsive {
            left: 0 !important;
            right: 0 !important;
        }
    }
}
