.mf-button-iframe {
    position: fixed;
    z-index: 21002;
    width: auto;
    height: auto;

    &.mf-button-iframe-top-left {
        top: 10px;
        left: 10px;
    }

    &.mf-button-iframe-top-right {
        top: 10px;
        right: 10px;
    }

    &.mf-button-iframe-bottom-left {
        bottom: 10px;
        left: 10px;
    }

    &.mf-button-iframe-bottom-right {
        bottom: 10px;
        right: 10px;
    }
}
