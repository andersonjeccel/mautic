{% set size = size|default('md') %}
{% set state = checked is defined and checked is not same as(null) ? checked : defaultChecked|default(false) %}
{% set hasDescription = description is defined and description is not same as(null) and description is not same as(false) and description is not same as('') and description is not same as(0) %}
{% set componentId = id|default('task-checkbox-' ~ random() ~ '-' ~ random()) %}
<div data-component="task-checkbox" data-size="{{ size }}" data-default-checked="{{ defaultChecked|default(false) ? 'true' : 'false' }}" data-controlled="{{ checked is defined ? 'true' : 'false' }}" data-checked="{{ state ? 'true' : 'false' }}" data-disabled="{{ disabled|default(false) ? 'true' : 'false' }}" class="task-checkbox {{ className|default('') }}">
  <button type="button" role="checkbox" aria-checked="{{ state ? 'true' : 'false' }}" aria-labelledby="{{ componentId }}-label"{% if hasDescription %} aria-describedby="{{ componentId }}-description"{% endif %}{% if disabled|default(false) %} disabled{% endif %} class="task-checkbox__button">
    <span class="task-checkbox__box" data-task-box style="transform:none"><span aria-hidden="true" class="task-checkbox__fill" data-task-fill style="transform:{{ state ? 'none' : 'scale(0)' }}"></span><svg class="task-checkbox__check" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12.5L10 17.5L19 7.5" pathLength="1" stroke-dasharray="{{ state ? '1' : '0' }}px 1px" stroke-dashoffset="0px" opacity="{{ state ? '1' : '0' }}"></path></svg></span>
  </button>
  <div class="task-checkbox__text" data-task-text><span id="{{ componentId }}-label" class="task-checkbox__label" data-task-label><span data-task-label-content>{% if label is same as(label ~ '') %}{{ label|trans }}{% elseif label is not same as(true) and label is not same as(false) %}{{ label }}{% endif %}</span><span aria-hidden="true" class="task-checkbox__strike" data-task-strike style="transform:{{ state ? 'none' : 'scaleX(0)' }};transform-origin:{{ state ? '0% 50%' : '100% 50%' }}"></span></span>{% if hasDescription %}<span id="{{ componentId }}-description" class="task-checkbox__description" data-task-description>{% if description is same as(description ~ '') %}{{ description|trans }}{% elseif description is not same as(true) and description is not same as(false) %}{{ description }}{% endif %}</span>{% elseif description is defined and description is same as(0) %}<span data-task-zero>0</span>{% endif %}</div>
</div>
