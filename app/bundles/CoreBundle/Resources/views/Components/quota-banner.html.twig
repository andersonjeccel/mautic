{% set variant = variant is defined ? variant : 'Banner' %}{% set upgradeLabel = upgradeLabel is defined ? upgradeLabel : 'Upgrade'|trans %}{% set options = {used:used,limit:limit,variant:variant,upgradeLabel:upgradeLabel,className:className|default('')} %}{% if resetsInSeconds is defined %}{% set options = options|merge({resetsInSeconds:resetsInSeconds}) %}{% endif %}<div data-component="quota-banner" data-options="{{ options|json_encode|escape('html_attr') }}" data-variant="{{ variant }}" data-exhausted="{{ used >= limit ? 'true' : 'false' }}" data-default-upgrade="{{ 'Upgrade'|trans }}" data-reached="{{ 'Message limit reached'|trans }}" data-left="{{ '%remaining% messages left today'|trans }}" data-reset-prefix="{{ '%separator% resets in '|trans }}" class="quota-banner {{ className|default('') }}"{% if variant != 'Compact' %} role="status"{% endif %}>{% if variant == 'Compact' %}<span data-usage class="quota-banner__usage">{{ used }}/{{ limit }}</span><span data-track aria-hidden="true" class="quota-banner__track"><span data-fill class="quota-banner__fill"></span></span>{% if resetsInSeconds is defined %}<span data-countdown class="quota-banner__countdown"></span>{% endif %}{% else %}<span class="quota-banner__badge"><svg class="quota-banner__icon" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 14a1 1 0 0 1-.78-1.63l9.9-10.2a.5.5 0 0 1 .86.46l-1.92 6.02A1 1 0 0 0 13 10h7a1 1 0 0 1 .78 1.63l-9.9 10.2a.5.5 0 0 1-.86-.46l1.92-6.02A1 1 0 0 0 11 14z"/></svg></span><div class="quota-banner__copy"><p data-heading class="quota-banner__heading">{{ used >= limit ? 'Message limit reached'|trans : '%remaining% messages left today'|trans({'%remaining%':limit-used}) }}</p><p data-meta class="quota-banner__meta"><span data-track aria-hidden="true" class="quota-banner__track"><span data-fill class="quota-banner__fill"></span></span>{{ used }}/{{ limit }}{% if resetsInSeconds is defined %}<span data-countdown></span>{% endif %}</p></div><button data-upgrade type="button" class="quota-banner__upgrade">{{ upgradeLabel }}</button>{% endif %}</div>
