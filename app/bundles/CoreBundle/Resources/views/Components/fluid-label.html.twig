{% set component = component|default('form-control') %}
{% set name = name|default('input') %}
{% set id = id|default(name|replace({'[': '-', ']': '', ' ': '-', '.': '-'})) %}
{% set label = label|default('') %}
{% set placeholder = placeholder|default(null) %}
{% set wrapperClass = wrapperClass|default('') %}
{% set attributes = attributes|default({}) %}
{% set inputWrapper = inputWrapper|default(null) %}
{% if role is defined and role %}
    {% set attributes = attributes|merge({role: role}) %}
{% endif %}
{% if autocomplete is defined and autocomplete %}
    {% set attributes = attributes|merge({autocomplete: autocomplete}) %}
{% endif %}
{% set icon = icon|default(null) %}
{% set helpText = helpText|default(null) %}
{% set validation = validation|default({}) %}
{% set link = link|default(null) %}
{% set invalid = invalid|default(false) %}
{% set invalidText = invalidText|default(null) %}
{% set warnText = warnText|default(null) %}
{% set feedbackId = id ~ '-invalid' %}
{% set helpId = id ~ '-help' %}
{% set warnId = id ~ '-warn' %}
{% set showHelp = helpText and not invalid %}
{% set showError = invalid and invalidText %}
{% set describedby = [] %}
{% if showHelp %}
    {% set describedby = describedby|merge([helpId]) %}
{% endif %}
{% if showError %}
    {% set describedby = describedby|merge([feedbackId]) %}
{% endif %}
{% if warnText %}
    {% set describedby = describedby|merge([warnId]) %}
{% endif %}
{% if invalid %}
    {% set attributes = attributes|merge({'aria-invalid': 'true', class: (attributes.class|default('') ~ ' is-invalid')|trim}) %}
{% endif %}


<div class="form-fluid{{ wrapperClass ? ' ' ~ wrapperClass }}">
    {% if label %}
        <div class="form-fluid__label">
            <label for="{{ id }}" class="form-label type-label-01 mb-0">{{ required|default(false) ? 'mautic.marketplace.forms.field.required'|trans({'%fieldLabel%': label|trans}) : label|trans }}</label>
            {% if showHelp %}
            <button type="button" class="form-fluid__help" data-toggle="tooltip" data-placement="top" title="{{ helpText|trans }}" aria-label="{{ 'mautic.marketplace.forms.field.help'|trans({'%fieldLabel%': label|trans}) }}">
                <i class="ri-information-line" aria-hidden="true"></i>
            </button>
            {% endif %}
        </div>
    {% endif %}
    {% if component == 'select' %}
        {% include '@MauticCore/Components/select.html.twig' with {
            id: id,
            name: name,
            label: null,
            labelPosition: 'bottom',
            icon: icon,
            options: options|default([]),
            value: value|default(null),
            disabled: disabled|default(false),
            required: required|default(false),
            multiple: multiple|default(false),
            helpText: null,
            describedby: describedby,
            wrapperClass: '',
            attributes: attributes,
            validation: validation
        } only %}
    {% else %}
        {% if inputWrapper %}
        <div class="{{ inputWrapper }}">
        {% endif %}
        {% include '@MauticCore/Components/form-control.html.twig' with {
            id: id,
            name: name,
            type: type|default('text'),
            label: null,
            labelPosition: 'bottom',
            icon: icon,
            value: value|default(''),
            placeholder: placeholder,
            rows: rows|default(3),
            plaintext: plaintext|default(false),
            disabled: disabled|default(false),
            readonly: readonly|default(false),
            required: required|default(false),
            helpText: null,
            describedby: describedby,
            render_feedback: false,
            wrapperClass: '',
            attributes: attributes,
            validation: validation
        } only %}
        {% if inputWrapper %}
        {% if search|default(false) %}
        <i class="ri-search-line form-fluid__search-icon" aria-hidden="true"></i>
        <button type="button" class="form-fluid__search-clear" aria-label="{{ 'mautic.marketplace.forms.field.clear_search'|trans }}" hidden>
            <i class="ri-close-line" aria-hidden="true"></i>
        </button>
        {% endif %}
        {% if passwordToggle|default(false) %}
        <button type="button" class="form-fluid__password-toggle" aria-label="{{ 'mautic.marketplace.forms.field.show_password'|trans }}" data-label-show="{{ 'mautic.marketplace.forms.field.show_password'|trans }}" data-label-hide="{{ 'mautic.marketplace.forms.field.hide_password'|trans }}" aria-pressed="false">
            <i class="ri-eye-line" aria-hidden="true"></i>
        </button>
        {% endif %}
        </div>
        {% endif %}
        {% if showHelp %}
        <span id="{{ helpId }}" class="visually-hidden">{{ helpText|trans }}</span>
        {% endif %}
    {% endif %}
    {% if showError %}
    <div id="{{ feedbackId }}" class="invalid-feedback d-flex justify-content-between align-items-center">
        <span class="text-danger">{{ invalidText|trans }}</span>
        <i class="ri-error-warning-fill text-danger" aria-hidden="true"></i>
    </div>
    {% endif %}
    {% if warnText %}
    <div id="{{ warnId }}" class="form-text d-flex justify-content-between align-items-center">
        <span class="text-body">{{ warnText|trans }}</span>
        <i class="ri-alert-fill text-warning" aria-hidden="true"></i>
    </div>
    {% endif %}
    {% if link %}
    <a href="{{ link.href }}">{{ link.label|trans }}</a>
    {% endif %}
</div>
