{% set component = component|default('form-control') %}
{% set name = name|default('floating-input') %}
{% set id = id|default(name|replace({'[': '-', ']': '', ' ': '-', '.': '-'})) %}
{% set label = label|default('') %}
{% set placeholder = placeholder|default(null) %}
{% set wrapperClass = wrapperClass|default('') %}
{% set attributes = attributes|default({}) %}
{% set icon = icon|default(null) %}
{% set helpText = helpText|default(null) %}
{% set validation = validation|default({}) %}
{% set link = link|default(null) %}


<div class="form-fluid{{ wrapperClass ? ' ' ~ wrapperClass }}">
    {% if component == 'select' %}
        {% include '@MauticCore/Components/select.html.twig' with {
            id: id,
            name: name,
            label: label,
            labelPosition: 'bottom',
            icon: icon,
            size: size|default(null),
            options: options|default([]),
            value: value|default(null),
            disabled: disabled|default(false),
            required: required|default(false),
            multiple: multiple|default(false),
            helpText: helpText,
            wrapperClass: '',
            attributes: attributes,
            validation: validation
        } only %}
    {% else %}
        {% include '@MauticCore/Components/form-control.html.twig' with {
            id: id,
            name: name,
            type: type|default('text'),
            label: label,
            labelPosition: 'bottom',
            icon: icon,
            value: value|default(''),
            placeholder: placeholder,
            rows: rows|default(3),
            size: size|default(null),
            plaintext: plaintext|default(false),
            disabled: disabled|default(false),
            readonly: readonly|default(false),
            required: required|default(false),
            helpText: helpText,
            wrapperClass: '',
            attributes: attributes,
            validation: validation
        } only %}
    {% endif %}
    {% if link %}
    <a href="{{ link.href }}">{{ link.label|trans }}</a>
    {% endif %}
</div>
