{% set extra %}
    <i class="ri-search-line form-fluid__search-icon" aria-hidden="true"></i>
    <button type="button" class="form-fluid__search-clear" aria-label="{{ closeButtonLabelText|default('mautic.marketplace.forms.field.clear_search')|trans }}" hidden>
        <i class="ri-close-line" aria-hidden="true"></i>
    </button>
{% endset %}
{% include '@MauticCore/Components/fluid-label.html.twig' with _context|merge({component: 'form-control', type: 'search', required: false, modifier: 'search', extra: extra, attributes: attributes|default({})|merge({role: role|default('searchbox'), autocomplete: autoComplete|default('off')})}) only %}
