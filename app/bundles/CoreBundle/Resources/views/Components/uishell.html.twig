{# 
Variables
    - header { children, ariaLabel (trans string)}
    - headerMenuButton { ariaLabel (trans string), className, renderMenuIcon (icon class), renderCloseIcon (icon class), isActive (true/false), isCollapsible (true/false), onClick }
    - headerName {prefix (trans string), children (trans string), className, href}
    - headerNavigation { className, children (headerMenu or headerMenuItem)}
    - headerMenu { className, focusRef, isActive, menuLinkName (trans string), onBlur, onClick, onKeyDown, tabIndex, renderMenuContent}
    - headerMenuItem { as, children (trans string), className, isActive, role, tabIndex, href}
    - headerGlobal { children, className}
    - headerGlobalAction { ariaLabel (trans string), className, renderActionIcon (icon class), isActive, onClick, tooltipAlignment }
    - headerGlobalDropdown { ariaLabel (trans string), className, renderDropdownIcon (icon class), tabIndex, renderMenuContent}
    - skipToContent { children, className, href, tabIndex }
#}

{# 
Example
