                'isCollapsible': true,
                'onClick': 'Mautic.openMenu();',
            },
            'headerName': {
                'prefix': 'Mautic',
                'children': 'Campaign Builder',
                'className': 'header__name',
                'href': '#header',
            },
            'headerNavigation': {
                'className': 'header__nav',
                'children': [
                    {
                        'headerMenuItem': {
                            'as': 'link',
                            'children': 'Link 1',
                            'className': 'header__menu-item',
                            'isActive': true,
                            'role': 'button',
                            'tabIndex': 0,
                            'href': '#header',
                        },
                    },
                    {
                        'headerMenuItem': {
                            'as': 'link',
                            'children': 'Link 2',
                            'className': 'header__menu-item',
                            'isActive': true,
                            'role': 'button',
                            'tabIndex': 0,
                            'href': '#header',
                        },
                    },
                    {
                        'headerMenu': {
                            'className': 'header__menu',
                            'focusRef': '#header-menu',
                            'isActive': true,
                            'menuLinkName': 'Link 3',
                            'onBlur': 'Mautic.closeMenu();',
                            'onClick': 'Mautic.openMenu();',
                            'onKeyDown': 'Mautic.openMenu();',
                            'tabIndex': 0,
                            'renderMenuContent': [
                                {
                                    'headerMenuItem': {
                                        'as': 'link',
                                        'children': 'Header',
                                        'className': 'header__menu-item',
                                        'isActive': true,
                                        'role': 'button',
                                        'tabIndex': 0,
                                        'href': '#header',
                                    },
                                },
                                {
                                    'headerMenuItem': {
                                        'as': 'link',
                                        'children': 'Header',
                                        'className': 'header__menu-item',
                                        'isActive': true,
                                        'role': 'button',
                                        'tabIndex': 0,
                                        'href': '#header',
                                    },
                                },
                            ],
                        },
                    },
                ],
            },
            'headerGlobal': {
                'children': {
                    'headerGlobalAction': {
