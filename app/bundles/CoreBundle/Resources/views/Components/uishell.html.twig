{# 
Variables
    - header { children, ariaLabel, ariaLabelledBy}
    - headerMenuButton { ariaLabel, ariaLabelledBy, className, renderMenuIcon, renderCloseIcon, isActive, isCollapsible, onClick }
    - headerName {prefix, children, className, href}
    - headerNavigation { className, children (headerMenu or headerMenuItem)}
    - headerMenu { className, focusRef, isActive, menuLinkName, onBlur, onClick, onKeyDown, tabIndex, renderMenuContent}
    - headerMenuItem { as, children, className, isActive, role, tabIndex, href}
    - headerGlobal { children, className}
    - headerGlobalAction { ariaLabel, ariaLabelledBy, className, children (icon class), isActive, onClick, tooltipAlignment }
#}

{# 
Example
{% include '@MauticCore/Components/uishell.html.twig' with {
    'header': {
        'ariaLabel': 'Header',
        'ariaLabelledBy': 'header',
        'children': {
            'headerMenuButton': {
                'ariaLabel': 'Open menu',
                'ariaLabelledBy': 'header-menu-button',
                'className': 'header__menu-trigger',
