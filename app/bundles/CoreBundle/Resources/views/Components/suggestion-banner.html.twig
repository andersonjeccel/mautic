{% import '@MauticCore/Components/suggestion-banner-content.html.twig' as content %}{% set suggestion = suggestion is defined ? suggestion : 'Flag Meridian Lines in the weekly carrier report'|trans %}{% set detail = detail is defined ? detail : 'Based on the SLA breach found on the Rotterdam–Felixstowe lane.'|trans %}{% set applyLabel = applyLabel is defined ? applyLabel : 'Apply'|trans %}{% set options = {suggestion:suggestion,detail:detail,applyLabel:applyLabel,variant:variant|default('Inline'),className:className|default('')} %}{% if state is defined %}{% set options = options|merge({state:state}) %}{% endif %}<div data-component="suggestion-banner" class="suggestion-banner-mount" data-options="{{ options|json_encode|escape('html_attr') }}" data-default-suggestion="{{ 'Flag Meridian Lines in the weekly carrier report'|trans }}" data-default-detail="{{ 'Based on the SLA breach found on the Rotterdam–Felixstowe lane.'|trans }}" data-default-apply="{{ 'Apply'|trans }}" data-applied-prefix="{{ 'Applied — '|trans }}">{% if state is not defined or state != 'dismissed' %}{{ content.banner(options,state is defined and state == 'applied') }}{% endif %}<template data-view="open">{{ content.banner(options,false) }}</template><template data-view="applied">{{ content.banner(options,true) }}</template></div>
