<div data-slot="toggle-item" class="animated-toggle__item {{ className|default('') }}" data-state="{{ contextPressed ? 'on' : 'off' }}"{% if contextDefined|default(false) and contextPressed is not same as(null) %} aria-pressed="{{ contextPressed ? 'true' : 'false' }}"{% endif %}{% if disabled is defined and disabled is not same as(null) %} data-disabled="{{ disabled ? 'true' : 'false' }}"{% endif %}{% for key, value in attributes|default({}) %}{% if value is not same as(null) %} {{ key }}="{{ value is same as(true) ? 'true' : (value is same as(false) ? 'false' : value) }}"{% endif %}{% endfor %}>{% if children is defined %}{% if children is same as(children ~ '') %}{{ children|trans }}{% elseif children is not same as(true) and children is not same as(false) %}{{ children }}{% endif %}{% endif %}</div>
