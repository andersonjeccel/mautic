{% set safeSeconds = seconds is defined and seconds is not same as(null) and seconds is not same as(false) and seconds is not same as(true) ? max(0, seconds|round(0,'floor')) : 0 %}{% set time = (safeSeconds / 60)|round(0,'floor') ~ ':' ~ ('%02d'|format(safeSeconds % 60)) %}<span role="timer" data-voice-prefix="{{ prefix|default('')|trans }}" class="voice-timer" aria-label="{{ ariaLabel is defined and ariaLabel is not same as(null) ? ariaLabel : (prefix is defined and prefix is not same as(null) and prefix is not same as(false) and prefix is not same as(0) and prefix is not same as('') ? prefix|trans ~ ' ' ~ time : time) }}">{{ time }}</span>
