{% set buttonTag = asChild|default(false) and tag|default('a') in ['button','a','span','div','label','strong','em','p'] ? tag|default('a') : 'button' %}
{% set booleanAttributes = ['disabled', 'hidden', 'autofocus', 'multiple', 'readonly', 'required', 'checked', 'selected', 'open', 'inert', 'novalidate', 'formnovalidate'] %}
{% set buttonAttributes = attributes|default({}) %}
{% for property in ['disabled','type','name','value','id','title'] %}{% if _context[property] is defined %}{% set buttonAttributes = buttonAttributes|merge({(property):_context[property]}) %}{% endif %}{% endfor %}
{% if asChild|default(false) %}{% set buttonAttributes = buttonAttributes|merge(childAttributes|default({})) %}{% endif %}
<{{ buttonTag }} data-component="acervo-button" data-variant="{{ variant is defined ? (variant is same as(null) ? 'none' : variant) : 'default' }}" data-size="{{ size is defined ? (size is same as(null) ? 'none' : size) : 'default' }}" class="acervo-button {{ className|default('') }} {{ asChild|default(false) ? childClassName|default('') : '' }}"{% for key, value in buttonAttributes %}{% if key matches '/^[a-zA-Z_:][a-zA-Z0-9_.:-]*$/' and key not in ['class','data-component','data-size','data-variant'] and value is not same as(null) and (key not in booleanAttributes or value is not same as(false)) %} {{ key }}="{{ key in booleanAttributes ? '' : (value is same as(true) ? 'true' : (value is same as(false) ? 'false' : value)) }}"{% endif %}{% endfor %}>{% if children is defined and children is not same as(true) and children is not same as(false) %}{% if children is same as(children ~ '') %}{{ children|trans }}{% else %}{{ children }}{% endif %}{% endif %}</{{ buttonTag }}>
