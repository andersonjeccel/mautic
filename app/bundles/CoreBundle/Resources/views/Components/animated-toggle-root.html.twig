{% set rootPressed = pressed is defined ? pressed : defaultPressed|default(false) %}
{% set contextDefined = pressed is defined or defaultPressed is defined %}
{% set contextPressed = pressed is defined ? pressed : (defaultPressed is defined ? defaultPressed : null) %}
<button type="button" data-component="animated-toggle" data-slot="toggle" data-controlled="{{ pressed is defined ? 'true' : 'false' }}" data-default-pressed="{{ defaultPressed|default(false) ? 'true' : 'false' }}" data-root-pressed="{{ rootPressed ? 'true' : 'false' }}" data-disabled-defined="{{ disabled is defined ? 'true' : 'false' }}" data-context-null="{{ contextPressed is same as(null) ? 'true' : 'false' }}" data-context-defined="{{ contextDefined ? 'true' : 'false' }}" data-context-pressed="{{ contextPressed ? 'true' : 'false' }}" data-state="{{ rootPressed ? 'on' : 'off' }}"{% if rootPressed is not same as(null) %} aria-pressed="{{ rootPressed ? 'true' : 'false' }}"{% endif %}{% if disabled|default(false) %} disabled data-disabled=""{% endif %} class="animated-toggle {{ rootClassName|default(className|default('')) }}"{% if styled|default(false) %} data-variant="{{ variant|default('default') }}" data-size="{{ size is defined ? (size is same as(null) ? 'none' : size) : 'default' }}"{% endif %}>
{% block toggle_content %}{% if itemEnabled|default(false) %}{% if contextPressed %}{% include '@MauticCore/Components/animated-toggle-highlight.html.twig' %}{% endif %}{% include '@MauticCore/Components/animated-toggle-item.html.twig' %}{% elseif children is defined and children is not same as(true) and children is not same as(false) %}{% if children is same as(children ~ '') %}{{ children|trans }}{% else %}{{ children }}{% endif %}{% endif %}{% endblock %}
{% if styled|default(false) or itemEnabled|default(false) or highlightEnabled|default(false) %}<template data-toggle-highlight-template>{% include '@MauticCore/Components/animated-toggle-highlight.html.twig' with {contextPressed:true, disabled:disabled|default(null)} %}</template>{% endif %}
</button>
