{% set initialState = state is defined ? state : 'idle' %}<div data-component="voice-input"{% if state is defined %} data-controlled-state="{{ state }}"{% endif %} data-state="{{ initialState }}" class="voice-input {{ className|default('') }}">{% include '@MauticCore/Components/voice-input-content.html.twig' with {state:initialState} only %}{% for stage in ['idle','recording','processing'] %}<template data-voice-stage="{{ stage }}">{% include '@MauticCore/Components/voice-input-content.html.twig' with {state:stage} only %}</template>{% endfor %}</div>
