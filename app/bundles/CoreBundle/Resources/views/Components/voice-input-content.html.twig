{% if state == 'idle' %}<button type="button" data-action="start" aria-label="{{ 'Start recording'|trans }}" class="voice-input__button voice-input__button--primary"><svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 2a3 3 0 0 0-3 3v7a3 3 0 0 0 6 0V5a3 3 0 0 0-3-3Z"/><path d="M19 10v2a7 7 0 0 1-14 0v-2"/><line x1="12" x2="12" y1="19" y2="22"/></svg></button><span class="voice-input__hint">{{ 'Tap to speak'|trans }}</span>{% elseif state == 'recording' %}<button type="button" data-action="cancel" aria-label="{{ 'Cancel recording'|trans }}" class="voice-input__button voice-input__button--cancel"><svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg></button>{% include '@MauticCore/Components/voice-visualizer.html.twig' with {} only %}{% include '@MauticCore/Components/voice-timer.html.twig' with {seconds:0,prefix:'Recording'} only %}<button type="button" data-action="confirm" aria-label="{{ 'Finish recording'|trans }}" class="voice-input__button voice-input__button--primary"><svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg></button>{% elseif state == 'processing' %}{% include '@MauticCore/Components/voice-visualizer.html.twig' with {active:false,barCount:10,className:'voice-visualizer--processing'} only %}<span role="status" class="voice-input__hint">{{ 'Transcribing…'|trans }}</span>{% endif %}
