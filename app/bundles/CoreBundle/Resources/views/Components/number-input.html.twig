{% set id = id|default(name|default('input')|replace({'[': '-', ']': '', ' ': '-', '.': '-'})) %}
{% set variant = variant|default('default') %}
{% set labelText = labelText|default('') %}
{% set wrapperClass = wrapperClass|default(null) %}
{% set invalid = invalid|default(false) %}
{% set invalidText = invalidText|default(null) %}
{% set warnText = warnText|default(null) %}
{% set helpText = helpText|default(null) %}
{% set link = link|default(null) %}
{% set describedby = describedby|default([]) %}
{% set attributes = attributes|default({}) %}
{% set iconDescription = iconDescription|default(null) %}
{% if invalid and invalidText %}{% set describedby = describedby|merge([id ~ '-invalid']) %}{% endif %}
{% if warnText and not invalid %}{% set describedby = describedby|merge([id ~ '-warn']) %}{% endif %}
{% if helpText and not invalid %}{% set describedby = describedby|merge([id ~ '-help']) %}{% endif %}
{% set numberAttributes = attributes|merge({min: min|default(null), max: max|default(null), step: step|default(null)}) %}
{% set control %}
    {% include '@MauticCore/Components/form-control.html.twig' with {
        id: id,
        name: name|default('input'),
        type: 'number',
        label: null,
        value: value|default(''),
        placeholder: placeholder|default(null),
        disabled: disabled|default(false),
        readonly: readonly|default(false),
        required: required|default(false),
        describedby: describedby,
        render_feedback: false,
        wrapperClass: '',
        attributes: invalid ? numberAttributes|merge({'aria-invalid': 'true', class: (attributes.class|default('') ~ ' is-invalid')|trim}) : numberAttributes,
        validation: validation|default({})
    } only %}
{% endset %}
{% set feedback %}
    {% if invalid and invalidText %}
    <div id="{{ id }}-invalid" class="invalid-feedback d-flex justify-content-between align-items-center">
        <span class="text-danger">{{ invalidText|trans }}</span>
        <i class="ri-error-warning-fill text-danger" aria-hidden="true"></i>
    </div>
    {% endif %}
    {% if helpText and not invalid %}
    <div id="{{ id }}-help" class="form-text">{{ helpText|trans }}</div>
    {% endif %}
    {% if link %}
    <a href="{{ link.href }}">{{ link.label|trans }}</a>
    {% endif %}
{% endset %}
{% if variant == 'fluid' %}
<div class="form-fluid form-fluid--number{{ wrapperClass ? ' ' ~ wrapperClass : '' }}">
    <div class="form-fluid__label">
        <label for="{{ id }}" class="form-label type-label-01 mb-0">{{ labelText|trans }}</label>
        {% if toggletipText %}
        <span class="form-fluid__toggletip-wrap">
            <button type="button" class="form-fluid__toggletip" aria-controls="{{ id }}-toggletip" aria-expanded="false" aria-label="{{ 'mautic.core.toggletip'|trans }}">
                <i class="ri-information-2-line" aria-hidden="true"></i>
            </button>
            <span id="{{ id }}-toggletip" class="form-fluid__toggletip-content bg-dark text-white small p-2 rounded shadow" hidden>{{ toggletipText|trans }}</span>
        </span>
        {% endif %}
    </div>
    <div class="form-field-with-number">
        {{ control|raw }}
        <div class="form-field-stepper">
            <button type="button" class="form-field-step" data-number-step="down" aria-label="{{ iconDescription|default('mautic.marketplace.forms.field.decrement_number')|trans }}" title="{{ iconDescription|default('mautic.marketplace.forms.field.decrement_number')|trans }}" {{ disabled|default(false) ? 'disabled' }}>
                <i class="ri-subtract-line" aria-hidden="true"></i>
            </button>
            <span class="form-field-separator" aria-hidden="true"></span>
            <button type="button" class="form-field-step" data-number-step="up" aria-label="{{ iconDescription|default('mautic.marketplace.forms.field.increment_number')|trans }}" title="{{ iconDescription|default('mautic.marketplace.forms.field.increment_number')|trans }}" {{ disabled|default(false) ? 'disabled' }}>
                <i class="ri-add-line" aria-hidden="true"></i>
            </button>
        </div>
    </div>
    {{ feedback|raw }}
</div>
{% else %}
<div class="{{ wrapperClass ?: '' }}">
    <label for="{{ id }}" class="form-label type-label-01">{{ labelText|trans }}</label>
    <div class="form-field-with-number">
        {{ control|raw }}
        <div class="form-field-stepper">
            <button type="button" class="form-field-step" data-number-step="down" aria-label="{{ iconDescription|default('mautic.marketplace.forms.field.decrement_number')|trans }}" title="{{ iconDescription|default('mautic.marketplace.forms.field.decrement_number')|trans }}" {{ disabled|default(false) ? 'disabled' }}>
                <i class="ri-subtract-line" aria-hidden="true"></i>
            </button>
            <button type="button" class="form-field-step" data-number-step="up" aria-label="{{ iconDescription|default('mautic.marketplace.forms.field.increment_number')|trans }}" title="{{ iconDescription|default('mautic.marketplace.forms.field.increment_number')|trans }}" {{ disabled|default(false) ? 'disabled' }}>
                <i class="ri-add-line" aria-hidden="true"></i>
            </button>
        </div>
    </div>
    {{ feedback|raw }}
</div>
{% endif %}
