{% set id = id|default(name|default('input')|replace({'[': '-', ']': '', ' ': '-', '.': '-'})) %}
{% set variant = variant|default('default') %}
{% set labelText = labelText|default('') %}
{% set wrapperClass = wrapperClass|default(null) %}
{% set invalid = invalid|default(false) %}
{% set invalidText = invalidText|default(null) %}
{% set warnText = warnText|default(null) %}
{% set helpText = helpText|default(null) %}
{% set link = link|default(null) %}
{% set describedby = describedby|default([]) %}
{% set attributes = attributes|default({}) %}
{% if invalid and invalidText %}{% set describedby = describedby|merge([id ~ '-invalid']) %}{% endif %}
{% if warnText and not invalid %}{% set describedby = describedby|merge([id ~ '-warn']) %}{% endif %}
{% if helpText and not invalid %}{% set describedby = describedby|merge([id ~ '-help']) %}{% endif %}
{% set control %}
    {% include '@MauticCore/Components/form-control.html.twig' with {
        id: id,
        name: name|default('input'),
        type: 'search',
        label: null,
        value: value|default(''),
        placeholder: placeholder|default(null),
        disabled: disabled|default(false),
        readonly: readonly|default(false),
        required: false,
        describedby: describedby,
        render_feedback: false,
        wrapperClass: '',
        attributes: invalid ? attributes|merge({role: role|default('searchbox'), autocomplete: autoComplete|default('off'), 'aria-invalid': 'true', class: (attributes.class|default('') ~ ' is-invalid')|trim}) : attributes|merge({role: role|default('searchbox'), autocomplete: autoComplete|default('off')}),
        validation: validation|default({})
    } only %}
{% endset %}
{% set extra %}
    <i class="ri-search-line form-fluid__search-icon" aria-hidden="true"></i>
    <button type="button" class="form-fluid__search-clear" aria-label="{{ closeButtonLabelText|default('mautic.marketplace.forms.field.clear_search')|trans }}" hidden>
        <i class="ri-close-line" aria-hidden="true"></i>
    </button>
{% endset %}
{% set feedback %}
    {% if invalid and invalidText %}
    <div id="{{ id }}-invalid" class="invalid-feedback d-flex justify-content-between align-items-center">
        <span class="text-danger">{{ invalidText|trans }}</span>
        <i class="ri-error-warning-fill text-danger" aria-hidden="true"></i>
    </div>
    {% endif %}
    {% if warnText and not invalid %}
    <div id="{{ id }}-warn" class="form-text d-flex justify-content-between align-items-center">
        <span class="text-body">{{ warnText|trans }}</span>
        <i class="ri-alert-fill text-warning" aria-hidden="true"></i>
    </div>
    {% endif %}
    {% if helpText and not invalid %}
    <div id="{{ id }}-help" class="form-text">{{ helpText|trans }}</div>
    {% endif %}
    {% if link %}
    <a href="{{ link.href }}">{{ link.label|trans }}</a>
    {% endif %}
{% endset %}
{% if variant == 'fluid' %}
<div class="form-fluid form-fluid--search{{ wrapperClass ? ' ' ~ wrapperClass : '' }}">
    <div class="form-fluid__label text-helper">
        <label for="{{ id }}" class="form-label type-label-01 mb-0">{{ labelText|trans }}</label>
    </div>
    {{ control|raw }}
    {{ extra|raw }}
    {{ feedback|raw }}
</div>
{% else %}
<div class="{{ wrapperClass ?: '' }}">
    <label for="{{ id }}" class="form-label type-label-01">{{ labelText|trans }}</label>
    <div class="form-field-default__search">
        {{ control|raw }}
        {{ extra|replace({'form-fluid__search-icon': 'form-field-default__search-icon', 'form-fluid__search-clear': 'form-field-default__search-clear'})|raw }}
    </div>
    {{ feedback|raw }}
</div>
{% endif %}
