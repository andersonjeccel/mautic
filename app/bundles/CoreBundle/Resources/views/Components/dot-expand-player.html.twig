{% set type = type is defined ? type : 'button' %}{% set customAriaLabel = attributes is defined and attributes['aria-label'] is defined %}{% set attributes = {'aria-label':label|trans}|merge(attributes|default({})) %}<button data-component="dot-expand-player" data-spectrum-component="DotExpandPlayer" data-state="idle" data-label="{{ label|trans }}" data-pause-pattern="{{ 'Pausar %label%'|trans }}" data-pause-label="{{ 'Pausar %label%'|trans({'%label%':label|trans}) }}" class="dot-expand-player {{ className|default('') }}"{% if type is not same as(null) %} type="{{ type }}"{% endif %}{% if customAriaLabel %} data-custom-aria-label="true"{% endif %}{% for key,value in attributes %}{% if key matches '/^[a-zA-Z_:][a-zA-Z0-9_.:-]*$/' and key not in ['class','type','data-component','data-state'] and value is not same as(null) and (key not in ['disabled','hidden','inert','autofocus','formnovalidate'] or value is not same as(false)) %} {{ key }}="{{ value is same as(false) ? 'false' : (value is same as(true) ? 'true' : value) }}"{% endif %}{% endfor %}><span aria-hidden="true" data-player-dot class="dot-expand-player__dot"><span class="dot-expand-player__icon"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-play" aria-hidden="true" data-testid="play-icon"><polygon points="6 3 20 12 6 21 6 3"/></svg></span></span><span data-player-content class="dot-expand-player__content"><span data-player-live>{{ label|trans }}</span><span aria-hidden="true" data-player-label-measure class="dot-expand-player__label-measure">{{ label|trans }}</span><span aria-hidden="true" data-player-playing-measure class="dot-expand-player__playing-measure">{% include '@MauticCore/Components/voice-visualizer.html.twig' with {active:false} only %}{% include '@MauticCore/Components/voice-timer.html.twig' with {seconds:0} only %}</span></span><template data-player-playing><span class="dot-expand-player__live" data-player-live>{% include '@MauticCore/Components/voice-visualizer.html.twig' with {} only %}{% include '@MauticCore/Components/voice-timer.html.twig' with {seconds:0,prefix:'Tempo reproduzido'} only %}</span></template><template data-player-play-icon><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-play" aria-hidden="true" data-testid="play-icon"><polygon points="6 3 20 12 6 21 6 3"/></svg></template><template data-player-pause-icon><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-pause" aria-hidden="true" data-testid="pause-icon"><rect x="14" y="4" width="4" height="16" rx="1"/><rect x="6" y="4" width="4" height="16" rx="1"/></svg></template></button><audio src="{{ src }}" preload="metadata" data-testid="dot-expand-player-audio"></audio>
