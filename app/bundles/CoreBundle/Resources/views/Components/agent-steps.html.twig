{% set options = {steps:steps,variant:variant is defined?variant:'Default',className:className|default('')} %}<ol data-component="agent-steps" data-options="{{ options|json_encode|escape('html_attr') }}" data-labels="{{ {running:'em execução'|trans,pending:'na fila'|trans,parallel:'parallel'|trans}|json_encode|escape('html_attr') }}" class="agent-steps {{ className|default('') }}"><template data-prototype="row"><li class="agent-steps__row"><div class="agent-steps__rail"><span class="agent-steps__status"></span></div><div class="agent-steps__body"><button type="button" class="agent-steps__button"><span class="agent-steps__name"></span><span class="agent-steps__meta"></span></button></div></li></template><template data-prototype="grid"><div class="agent-steps__grid"><div class="agent-steps__overflow"></div></div></template><template data-prototype="child"><div class="agent-steps__child"><div class="agent-steps__child-header"><span class="agent-steps__dot agent-steps__child-dot"></span><span class="agent-steps__child-name"></span></div></div></template><template data-prototype="chevron"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="agent-steps__chevron"><path d="m6 9 6 6 6-6"/></svg></template><template data-prototype="pending"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="agent-steps__pending"><path d="M10.1 2.182a10 10 0 0 1 3.8 0"/><path d="M13.9 21.818a10 10 0 0 1-3.8 0"/><path d="M17.609 3.721a10 10 0 0 1 2.69 2.7"/><path d="M2.182 13.9a10 10 0 0 1 0-3.8"/><path d="M20.279 17.609a10 10 0 0 1-2.7 2.69"/><path d="M21.818 10.1a10 10 0 0 1 0 3.8"/><path d="M3.721 6.391a10 10 0 0 1 2.7-2.69"/><path d="M6.391 20.279a10 10 0 0 1-2.69-2.7"/></svg></template><template data-prototype="success"><span class="agent-steps__terminal"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg></span></template><template data-prototype="error"><span class="agent-steps__terminal"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg></span></template>{% for step in steps %}{% if step.content is defined %}<template data-content-slot="{{ step.id }}"{% if step.richContent|default(false) %} data-rich-content{% endif %}>{{ step.content is iterable ? '' : step.content }}</template>{% endif %}{% endfor %}</ol>
