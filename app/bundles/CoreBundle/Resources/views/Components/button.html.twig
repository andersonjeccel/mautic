{# 
    Variables
        - buttons
        - className
        - dangerDescription
        - disabled
        - hasIconOnly
        - href
        - iconDescription
        - isExpressive
        - isSelected
        - label
        - variant
        - onBlur
        - onClick
        - onFocus
        - onMouseEnter
        - onMouseLeave
        - rel
        - renderIcon
        - role
        - size
        - tabIndex
        - target
        - tooltipPosition
        - type
        - attributes
#}
{% for button in buttons %}
    {# Add generated ID if not defined in attributes #}
    {% if button.attributes.id is not defined %}
        {% set label_split = button.label|split('.') %}
        {% set last_two = label_split|slice(-2, 2) %}
        {% set id = last_two|join('-')|replace({'_': '-'}) %}
    {% endif %}

    <{{ button.href is defined ? 'a' : 'button' }}
        {% if button.attributes.id is defined %}id="{{ button.attributes.id }}"{% endif %}
        class="btn btn-{{ button.variant|default('tertiary') }} 
               {% if button.hasIconOnly is defined and button.hasIconOnly %}btn-icon{% endif %} 
               {% if button.danger is defined and button.danger %}btn-danger{% endif %} 
               {% if button.wide is defined and button.wide %}btn-block{% endif %} 
               {% if button.spin is defined and button.spin == false %}btn-nospin{% endif %} 
               {{ button.className|default('') }}"
        aria-label="{{ button.dangerDescription|default(button.label) }}{{ button.iconDescription|default(button.label) }}"
        {% if button.href is defined %}href="{{ button.href }}"{% else %}type="{{ button.type|default('button') }}"{% endif %}
        {% if button.disabled is defined and button.disabled %}disabled{% endif %}
        {% if button.onBlur is defined %}onblur="{{ button.onBlur }}"{% endif %}
        {% if button.onClick is defined %}onclick="{{ button.onClick }}"{% endif %}
        {% if button.onFocus is defined %}onfocus="{{ button.onFocus }}"{% endif %}
        {% if button.onMouseEnter is defined %}onmouseenter="{{ button.onMouseEnter }}"{% endif %}
        {% if button.onMouseLeave is defined %}onmouseleave="{{ button.onMouseLeave }}"{% endif %}
        {% if button.rel is defined %}rel="{{ button.rel }}"{% endif %}
        {% if button.role is defined %}role="{{ button.role }}"{% endif %}
        size="{{ button.size|default('md') }}"
        {% if button.tabIndex is defined %}tabindex="{{ button.tabIndex }}"{% endif %}
        {% if button.target is defined %}target="{{ button.target }}"{% endif %}
        {% if button.attributes is defined %}
            {% for attribute, value in button.attributes %}
                {{ attribute }}="{{ value|e('html_attr') }}"
            {% endfor %}
        {% endif %}>
        {% if button.renderIcon is defined %}
            <i class="{{ button.renderIcon }}" 
               aria-hidden="true" 
               {% if button.hasIconOnly is defined and button.hasIconOnly %}
                   data-toggle="tooltip" 
                   title="{{ button.label|trans }}" 
                   data-placement="{{ button.tooltipPosition|default('top') }}"
               {% endif %}>
            </i>
        {% endif %}
        {% if button.label is defined and not (button.hasIconOnly is defined and button.hasIconOnly) %}
            <span {% if button.isExpressive is defined and button.isExpressive %}class="type-body-02"{% endif %}>
                {{ button.label|trans }}
            </span>
        {% endif %}
    </{{ button.href is defined ? 'a' : 'button' }}>
{% endfor %}
