{% set tag = asChild|default(false) ? childTag|default('span') : 'span' %}{% if not (tag matches '/^[a-z][a-z0-9-]*$/') %}{% set tag = 'span' %}{% endif %}<{{ tag }} data-component="acervo-avatar" data-slot="avatar" data-src="{{ src|default('') }}"{% if delayMs is defined %} data-delay-ms="{{ delayMs }}"{% endif %}{% if crossOrigin is defined %} data-cross-origin="{{ crossOrigin }}"{% endif %}{% if referrerPolicy is defined %} data-referrer-policy="{{ referrerPolicy }}"{% endif %} class="acervo-avatar {{ (childClassName|default('') ~ ' ' ~ className|default('')) }}"{% for key,value in attributes|default({})|merge(childAttributes|default({})) %}{% if key matches '/^[a-zA-Z_:][a-zA-Z0-9_.:-]*$/' and key not in ['class','data-component','data-slot'] and value is not same as(null) and (key not in ['hidden','inert','disabled','draggable'] or key == 'draggable' or value is not same as(false)) %} {{ key }}="{{ value is same as(false) ? 'false' : (value is same as(true) ? 'true' : value) }}"{% endif %}{% endfor %}>{% if delayMs is not defined %}{% include '@MauticCore/Components/acervo-avatar-fallback.html.twig' %}{% endif %}<template data-avatar-image>{% include '@MauticCore/Components/acervo-avatar-image.html.twig' %}</template><template data-avatar-fallback>{% include '@MauticCore/Components/acervo-avatar-fallback.html.twig' %}</template></{{ tag }}>
