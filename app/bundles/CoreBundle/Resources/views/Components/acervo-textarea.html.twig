{% set controlled = value is defined and value is not same as(null) %}
{% set content = controlled ? value : (defaultValue is defined ? defaultValue : '') %}
<textarea{% if defaultValue is defined %} data-default-value="{{ defaultValue }}"{% endif %} data-component="acervo-textarea" data-controlled-value="{{ controlled ? 'true' : 'false' }}" class="acervo-textarea {{ className|default('') }}"{% for attribute in ['disabled', 'required'] %}{% if attribute(_context, attribute)|default(false) %} {{ attribute }}{% endif %}{% endfor %}{% if readOnly|default(false) %} readonly{% endif %}{% if autoFocus|default(false) %} autofocus{% endif %}{% for attribute in ['id', 'name', 'form', 'rows', 'cols', 'wrap', 'inputMode', 'autoComplete', 'maxLength', 'minLength'] %}{% if attribute(_context, attribute) is defined %} {{ attribute|lower }}="{{ attribute(_context, attribute) }}"{% endif %}{% endfor %}{% if spellCheck is defined %} spellcheck="{{ spellCheck ? 'true' : 'false' }}"{% endif %}{% if placeholder is defined %} placeholder="{{ placeholder|trans }}"{% endif %}{% if label is defined %} aria-label="{{ label|trans }}"{% endif %}{% for key, value in attributes|default({}) %} {{ key }}="{{ value }}"{% endfor %}>{% if (content ~ '') starts with "\n" %}{{ "\n" }}{% endif %}{{ content }}</textarea>
