{% set options = {calls:calls,variant:variant|default('Row'),className:className|default('')} %}<div data-component="tool-chips" data-options="{{ options|json_encode|escape('html_attr') }}" data-running="{{ 'running'|trans }}" data-duration="{{ '%duration%s'|trans }}" class="tool-chips {{ className|default('') }}" data-variant="{{ options.variant }}"><div data-list class="tool-chips__list"></div><div data-grid class="tool-chips__grid" style="grid-template-rows:0fr"><div data-overflow class="tool-chips__overflow"></div></div><template data-prototype="chip"><button type="button" aria-expanded="false" class="tool-chips__chip"><span data-dot class="tool-chips__dot"></span><span data-name class="tool-chips__name"></span></button></template><template data-prototype="result"><div class="tool-chips__panel"><p data-result class="tool-chips__result"></p></div></template></div>
