{% set options = {text:text,streaming:streaming|default(false),citations:citations|default([]),followUps:followUps|default([]),variant:variant|default('Answer'),className:className|default('')} %}<div data-component="streaming-text" class="streaming-text {{ className|default('') }}" data-options="{{ options|json_encode|escape('html_attr') }}" data-single-source="{{ '%count% source'|trans }}" data-many-sources="{{ '%count% sources'|trans }}" data-followups-label="{{ 'Follow-ups'|trans }}"><style>@keyframes streaming-caret{0%,49%{opacity:1}50%,100%{opacity:0}}@keyframes streaming-message{from{opacity:0;transform:translateY(6px)}to{opacity:1;transform:none}}</style><p data-answer class="streaming-text__answer"{% if options.streaming %} aria-hidden="true"{% endif %}><span data-part>{{ text }}</span></p><template data-prototype="source"><li class="streaming-text__source"><span data-index class="streaming-text__source-index"></span><span class="streaming-text__source-meta"><span data-title class="streaming-text__source-title"></span><span data-host class="streaming-text__source-host"></span></span></li></template><template data-prototype="badge"><span class="streaming-text__badge"></span></template><template data-prototype="followup"><li class="streaming-text__followup-item"><button type="button" data-followup class="streaming-text__followup"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="streaming-text__return"><path d="M20 4v7a4 4 0 0 1-4 4H4"/><path d="m9 10-5 5 5 5"/></svg></button></li></template></div>
