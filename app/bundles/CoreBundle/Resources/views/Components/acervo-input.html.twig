{% set controlled = value is defined and value is not same as(null) %}
{% set content = controlled ? value : (defaultValue is defined ? defaultValue : '') %}
{% set state = checked is defined and checked is not same as(null) ? checked : defaultChecked|default(false) %}
<input{% if defaultValue is defined %} data-default-value="{{ defaultValue }}"{% endif %} data-component="acervo-input" data-controlled-value="{{ controlled ? 'true' : 'false' }}" data-controlled-checked="{{ checked is defined and checked is not same as(null) ? 'true' : 'false' }}" class="acervo-input {{ className|default('') }}" type="{{ type|default('text') }}"{% if value is defined or defaultValue is defined %} value="{{ content }}"{% endif %}{% if state %} checked{% endif %}{% for attribute in ['disabled', 'required', 'multiple'] %}{% if attribute(_context, attribute)|default(false) %} {{ attribute }}{% endif %}{% endfor %}{% if readOnly|default(false) %} readonly{% endif %}{% if autoFocus|default(false) %} autofocus{% endif %}{% for attribute in ['id', 'name', 'form', 'min', 'max', 'step', 'pattern', 'accept', 'inputMode', 'autoComplete', 'maxLength', 'minLength', 'size'] %}{% if attribute(_context, attribute) is defined %} {{ attribute|lower }}="{{ attribute(_context, attribute) }}"{% endif %}{% endfor %}{% if spellCheck is defined %} spellcheck="{{ spellCheck ? 'true' : 'false' }}"{% endif %}{% if placeholder is defined %} placeholder="{{ placeholder|trans }}"{% endif %}{% if label is defined %} aria-label="{{ label|trans }}"{% endif %}{% for key, content in attributes|default({}) %} {{ key }}="{{ content }}"{% endfor %}>
