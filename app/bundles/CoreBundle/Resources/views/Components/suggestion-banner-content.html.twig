{% macro banner(options, applied) %}<div data-banner data-mode="{{ applied ? 'applied' : 'open' }}" class="suggestion-banner suggestion-banner--{{ applied ? 'applied' : 'open' }} {{ options.variant == 'Floating' and not applied ? 'suggestion-banner--floating' : '' }} {{ options.className }}"{% if applied %} role="status"{% endif %}><style>@keyframes suggestion-pop{0%{opacity:0;transform:scale(.85)}100%{opacity:1;transform:none}}@keyframes suggestion-message{from{opacity:0;transform:translateY(4px)}to{opacity:1;transform:none}}</style>{% if applied %}<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="suggestion-banner__check"><path d="M20 6 9 17l-5-5"/></svg>{{ 'Applied — '|trans }}{{ (options.suggestion|slice(0,1)|lower) ~ (options.suggestion|slice(1)) }}{% else %}<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="suggestion-banner__sparkles"><path d="M9.937 15.5A2 2 0 0 0 8.5 14.063l-6.135-1.582a.5.5 0 0 1 0-.962L8.5 9.936A2 2 0 0 0 9.937 8.5l1.582-6.135a.5.5 0 0 1 .963 0L14.063 8.5A2 2 0 0 0 15.5 9.937l6.135 1.581a.5.5 0 0 1 0 .964L15.5 14.063a2 2 0 0 0-1.437 1.437l-1.582 6.135a.5.5 0 0 1-.963 0z"/><path d="M20 3v4"/><path d="M22 5h-4"/><path d="M4 17v2"/><path d="M5 18H3"/></svg><div class="suggestion-banner__copy"><p data-suggestion class="suggestion-banner__suggestion">{{ options.suggestion }}</p>{% if options.detail is not same as('') %}<p data-detail class="suggestion-banner__detail">{{ options.detail }}</p>{% endif %}</div><div class="suggestion-banner__actions"><button type="button" data-action="dismiss" aria-label="{{ 'Dismiss suggestion'|trans }}" class="suggestion-banner__dismiss"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="suggestion-banner__cross"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg></button><button type="button" data-action="apply" class="suggestion-banner__apply">{{ options.applyLabel }}</button></div>{% endif %}</div>{% endmacro %}