{% set options = {tasks:tasks,variant:variant|default('Default'),className:className|default('')} %}<ul data-component="task-rows" data-options="{{ options|json_encode|escape('html_attr') }}" data-labels="{{ {queued:'Pendente'|trans,running:'Em andamento'|trans,completed:'Concluído'|trans,failed:'Falhou'|trans}|json_encode|escape('html_attr') }}" data-variant="{{ options.variant }}" class="task-rows {{ className|default('') }}"><template data-prototype="row"><li class="task-rows__row"><button type="button" data-task class="task-rows__button"><span class="task-rows__heading"><span data-title class="task-rows__title"></span></span><span data-badge class="task-rows__badge"></span></button></li></template><template data-prototype="grid"><div data-grid class="task-rows__grid"><div class="task-rows__overflow"><div data-note class="task-rows__note"></div></div></div></template><template data-prototype="queued"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="task-rows__icon"><path d="M10.1 2.182a10 10 0 0 1 3.8 0"/><path d="M13.9 21.818a10 10 0 0 1-3.8 0"/><path d="M17.609 3.721a10 10 0 0 1 2.69 2.7"/><path d="M2.182 13.9a10 10 0 0 1 0-3.8"/><path d="M20.279 17.609a10 10 0 0 1-2.7 2.69"/><path d="M21.818 10.1a10 10 0 0 1 0 3.8"/><path d="M3.721 6.391a10 10 0 0 1 2.7-2.69"/><path d="M6.391 20.279a10 10 0 0 1-2.69-2.7"/></svg></template><template data-prototype="running"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="task-rows__icon"><path d="M21 12a9 9 0 1 1-6.219-8.56"/></svg></template><template data-prototype="completed"><span class="task-rows__terminal"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="task-rows__icon"><path d="M20 6 9 17l-5-5"/></svg></span></template><template data-prototype="failed"><span class="task-rows__terminal"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="task-rows__icon"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg></span></template><template data-prototype="chevron"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="task-rows__chevron"><path d="m6 9 6 6 6-6"/></svg></template>{% block task_rows_notes %}{% for task in tasks %}{% if task.note is defined and task.note is not iterable and task.note is not same as(true) and task.note is not same as(false) and task.note is not same as(null) %}<template data-note-slot="{{ task.id }}"{% if task.note is not same as(task.note ~ '') and (task.note|json_encode) starts with '"' %} data-rich-note{% endif %}>{{ task.note }}</template>{% endif %}{% endfor %}{% endblock %}</ul>
