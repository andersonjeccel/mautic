{% set id = id|default(name|default('input')|replace({'[': '-', ']': '', ' ': '-', '.': '-'})) %}
{% set invalid = invalid|default(false) %}
{% set describedby = describedby|default([]) %}
{% set control %}
    {% include '@MauticCore/Components/select.html.twig' with {
        id: id,
        name: name|default('input'),
        label: null,
        options: options|default([]),
        value: defaultValue|default(value|default(null)),
        disabled: disabled|default(false),
        required: required|default(false),
        multiple: multiple|default(false),
        helpText: helpText|default(null),
        describedby: describedby,
        render_feedback: false,
        wrapperClass: '',
        attributes: invalid ? (attributes|default({})|merge({'aria-invalid': 'true', class: (attributes.class|default('') ~ ' is-invalid')|trim})) : attributes|default({}),
        validation: validation|default({})
    } only %}
{% endset %}
{% include '@MauticCore/Components/fluid-field.html.twig' with _context|merge({control: control}) only %}
