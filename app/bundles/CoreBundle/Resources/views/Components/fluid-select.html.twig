{% set id = id|default(name|default('input')|replace({'[': '-', ']': '', ' ': '-', '.': '-'})) %}
{% set helpText = helpText|default(null) %}
{% set describedby = describedby|default([]) %}
<div class="form-fluid{{ wrapperClass ? ' ' ~ wrapperClass }}">
    <div class="form-fluid__label">
        <label for="{{ id }}" class="form-label type-label-01 mb-0">{{ labelText|trans }}</label>
    </div>
    {% include '@MauticCore/Components/select.html.twig' with {
        id: id,
        name: name|default('input'),
        label: null,
        options: options|default([]),
        value: defaultValue|default(value|default(null)),
        disabled: disabled|default(false),
        required: required|default(false),
        multiple: multiple|default(false),
        helpText: helpText,
        describedby: describedby,
        wrapperClass: '',
        attributes: attributes|default({})
    } only %}
</div>
