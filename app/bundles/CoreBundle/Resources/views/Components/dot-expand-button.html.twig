{% set type = type is defined ? type : 'button' %}{% set content = children is defined and children is not same as(null) ? children : (label is defined ? label : null) %}<button data-spectrum-component="DotExpandButton" data-component="dot-expand-button" class="dot-expand-button {{ className|default('') }}"{% if type is not same as(null) %} type="{{ type }}"{% endif %}{% for key,value in attributes|default({}) %}{% if key matches '/^[a-zA-Z_:][a-zA-Z0-9_.:-]*$/' and key not in ['class','type','data-component'] and value is not same as(null) and (key not in ['disabled','hidden','inert','autofocus','formnovalidate'] or value is not same as(false)) %} {{ key }}="{{ value is same as(false) ? 'false' : (value is same as(true) ? 'true' : value) }}"{% endif %}{% endfor %}><span aria-hidden="true" class="dot-expand-button__dot"><span class="dot-expand-button__icon">{% block dot_expand_button_icon %}{% if icon is not defined %}<svg stroke="currentColor" fill="none" width="1em" height="1em" stroke-width="2" viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>{% elseif icon is not same as(null) and icon is not same as(true) and icon is not same as(false) %}{{ icon }}{% endif %}{% endblock %}</span></span><span>{% block dot_expand_button_children %}{% if content is not same as(null) and content is not same as(true) and content is not same as(false) %}{% if content is same as(content ~ '') %}{{ content|trans }}{% else %}{{ content }}{% endif %}{% endif %}{% endblock %}</span></button>
