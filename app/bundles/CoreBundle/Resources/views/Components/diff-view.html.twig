{% set labels = {accept:'Accept changes to %path%'|trans,reject:'Reject changes to %path%'|trans,accepted:'accepted'|trans,rejected:'rejected'|trans} %}{% set options = {diffs:diffs,variant:variant is defined?variant:'Default',className:className|default('')} %}<div data-component="diff-view" data-options="{{ options|json_encode|escape('html_attr') }}" data-labels="{{ labels|json_encode|escape('html_attr') }}" class="diff-view {{ className|default('') }}"><template data-prototype="card"><div class="diff-view__card"><div class="diff-view__header"><span class="diff-view__file"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="diff-view__file-code-2"><path d="M4 22h14a2 2 0 0 0 2-2V7l-5-5H6a2 2 0 0 0-2 2v4"/><path d="M14 2v4a2 2 0 0 0 2 2h4"/><path d="m5 12-3 3 3 3"/><path d="m9 18 3-3-3-3"/></svg><span data-path class="diff-view__path"></span></span><span class="diff-view__tools"><span class="diff-view__counts"><span data-additions class="diff-view__additions"></span> <span data-deletions class="diff-view__deletions"></span></span></span></div></div></template><template data-prototype="actions"><span class="diff-view__actions"><button type="button" data-reject class="diff-view__reject"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="diff-view__x"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg></button><button type="button" data-accept class="diff-view__accept"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="diff-view__check"><path d="M20 6 9 17l-5-5"/></svg></button></span></template><template data-prototype="decision"><span class="diff-view__decision"></span></template><template data-prototype="lines"><div class="diff-view__lines"></div></template><template data-prototype="line"><div class="diff-view__line"><span aria-hidden="true" class="diff-view__sign"></span></div></template></div>
