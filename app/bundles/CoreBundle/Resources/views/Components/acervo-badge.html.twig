{% set badgeTag = asChild|default(false) and tag|default('span') in ['div', 'span', 'a', 'button', 'label', 'strong', 'em', 'p'] ? tag|default('span') : 'div' %}
{% set booleanAttributes = ['disabled', 'hidden', 'autofocus', 'multiple', 'readonly', 'required', 'checked', 'selected', 'open', 'inert', 'novalidate', 'formnovalidate'] %}
{% set badgeAttributes = asChild|default(false) ? attributes|default({})|merge(childAttributes|default({})) : attributes|default({}) %}
<{{ badgeTag }} data-component="acervo-badge" data-variant="{{ variant is defined ? (variant is same as(null) ? 'none' : variant) : 'default' }}" class="acervo-badge {{ className|default('') }} {{ asChild|default(false) ? childClassName|default('') : '' }}"{% for key, value in badgeAttributes %}{% if key matches '/^[a-zA-Z_:][a-zA-Z0-9_.:-]*$/' and key not in ['class', 'data-component', 'data-variant'] and value is not same as(null) and (key not in booleanAttributes or value is not same as(false)) %} {{ key }}="{{ key in booleanAttributes ? '' : (value is same as(true) ? 'true' : (value is same as(false) ? 'false' : value)) }}"{% endif %}{% endfor %}>{% if children is defined and children is not same as(true) and children is not same as(false) %}{% if children is same as(children ~ '') %}{{ children|trans }}{% else %}{{ children }}{% endif %}{% endif %}</{{ badgeTag }}>
