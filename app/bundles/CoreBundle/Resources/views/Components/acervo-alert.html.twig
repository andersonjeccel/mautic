{% set attributes = attributes|default({}) %}{% set attributes = {role: 'alert'}|merge(attributes) %}{% set variant = variant is defined ? variant : 'default' %}<div data-slot="alert" class="acervo-alert{% if variant is not same as(null) %} acervo-alert--{{ variant }}{% endif %} {{ className|default('') }}"{% for key,value in attributes %}{% if key matches '/^[a-zA-Z_:][a-zA-Z0-9_.:-]*$/' and key not in ['class','data-slot'] and value is not same as(null) and (key not in ['hidden','inert'] or value is not same as(false)) %} {{ key }}="{{ value is same as(false) ? 'false' : (value is same as(true) ? 'true' : value) }}"{% endif %}{% endfor %}>{% block alert_children %}{% if children is defined and children is not same as(true) and children is not same as(false) %}{% if children is same as(children ~ '') %}{{ children|trans }}{% else %}{{ children }}{% endif %}{% endif %}{% endblock %}</div>
