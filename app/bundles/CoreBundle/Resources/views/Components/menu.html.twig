<div class="dropdown-menu {{ Menu.className|default('') }} {% if Menu.menuAlignment is defined and Menu.menuAlignment == 'right' %}dropdown-menu-right{% endif %}" role="menu">
    {% for item in Menu.children %}
        {% if item.MenuItem is defined %}
            {% set menuItem = item.MenuItem %}
            <li>
                <a href="{{ menuItem.href|default('#') }}"
                    class="dropdown-item {{ menuItem.className|default('') }} {% if menuItem.disabled is defined and menuItem.disabled %}disabled{% endif %} {% if menuItem.variant is defined %}text-{{ menuItem.variant }}{% endif %}"
                    {% if menuItem.disabled is defined and menuItem.disabled %}aria-disabled="true"{% endif %}
                    role="menuitem"
                    {% if menuItem.shortcut is defined %}title="{{ menuItem.shortcut|trans }}"{% endif %}
                    {% if menuItem.attributes is defined %}{% for attr, value in menuItem.attributes %}{{ attr }}="{{ value }}" {% endfor %}{% endif %}
                >
                    {% if menuItem.renderIcon is defined %}
                        <i class="{{ menuItem.renderIcon }}"></i>
                    {% endif %}
                    <span>{{ menuItem.label|trans }}</span>
                    {% if menuItem.shortcut is defined %}
                        <div class="shortcut ml-auto">{{ menuItem.shortcut|trans }}</div>
                    {% endif %}
                </a>
            </li>
        {% elseif item.MenuItemDivider is defined %}
            {% set divider = item.MenuItemDivider %}
            <div class="dropdown-divider {{ divider.className|default('') }}"></div>
        {% endif %}
    {% endfor %}
</div>

