{% set labelTag = asChild|default(false) and tag|default('label') in ['label', 'span', 'div', 'p', 'a', 'button', 'strong', 'em'] ? tag|default('label') : 'label' %}
{% set labelAttributes = asChild|default(false) ? attributes|default({})|merge(childAttributes|default({})) : attributes|default({}) %}
<{{ labelTag }} data-component="acervo-label" class="acervo-label {{ className|default('') }} {{ asChild|default(false) ? childClassName|default('') : '' }}"{% if htmlFor is defined and 'for' not in labelAttributes|keys %} for="{{ htmlFor }}"{% endif %}{% for key, value in labelAttributes %}{% if key matches '/^[a-zA-Z_:][a-zA-Z0-9_.:-]*$/' and key not in ['class', 'data-component'] and value is not same as(null) %} {{ key }}="{{ value is same as(true) ? 'true' : (value is same as(false) ? 'false' : value) }}"{% endif %}{% endfor %}>{% if children is defined and children is not same as(true) and children is not same as(false) %}{% if children is same as(children ~ '') %}{{ children|trans }}{% else %}{{ children }}{% endif %}{% endif %}</{{ labelTag }}>
