{% set count = count is defined ? count : 0 %}{% set max = max is defined ? max : 99 %}{% set size = size|default('md') %}<button type="button" data-component="notification-bell" data-class-name="{{ className|default('') }}" data-size="{{ size }}" data-count="{{ count }}" data-max="{{ max }}" data-dot="{{ dot|default(false) ? 'true' : 'false' }}" data-ring-on-mount="{{ ringOnMount|default(false) ? 'true' : 'false' }}" data-label-zero="{{ 'Notifications'|trans }}" data-label-unread="{{ 'Notifications, %count% unread'|trans }}" data-announce-one="{{ '%count% unread notification'|trans }}" data-announce-many="{{ '%count% unread notifications'|trans }}"{% if ariaLabel is defined and ariaLabel is not same as(null) %} data-custom-label="{{ ariaLabel }}"{% endif %}{% if announcement is defined and announcement is not same as(null) %} data-custom-announcement="{{ announcement }}"{% endif %} aria-label="{{ ariaLabel is defined and ariaLabel is not same as(null) ? ariaLabel : (count > 0 ? 'Notifications, %count% unread'|trans({'%count%':count}) : 'Notifications'|trans) }}" class="notification-bell notification-bell--{{ size }} {{ className|default('') }}"><span data-bell class="notification-bell__bell" style="transform-origin:top center"><svg viewBox="0 0 24 24" width="{{ size == 'sm' ? 16 : (size == 'lg' ? 24 : 20) }}" height="{{ size == 'sm' ? 16 : (size == 'lg' ? 24 : 20) }}" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 8a6 6 0 0 1 12 0c0 7 3 9 3 9H3s3-2 3-9"/><path data-clapper d="M10.3 21a1.94 1.94 0 0 0 3.4 0" style="transform-box:fill-box;transform-origin:50% 50%"/></svg></span>{% if count > 0 %}<span data-bell-indicator aria-hidden="true" class="{{ dot|default(false) ? 'notification-bell__dot' : 'notification-bell__badge' }}">{% if dot|default(false) %}<span class="notification-bell__dot-core"></span>{% else %}<span class="notification-bell__digits"><span class="notification-bell__digit">{{ count > max ? max ~ '+' : count }}</span></span>{% endif %}</span>{% endif %}<span class="notification-bell__status" role="status" aria-live="polite">{{ announcement is defined and announcement is not same as(null) ? announcement : (count > 0 ? (count == 1 ? '%count% unread notification' : '%count% unread notifications')|trans({'%count%':count}) : '') }}</span></button>
