{% set options = {text:text,citations:citations,variant:variant is defined?variant:'Inline',className:className|default('')} %}<div data-component="citation-sources" data-options="{{ options|json_encode|escape('html_attr') }}" data-label="{{ 'Source %index%: %title%'|trans|escape('html_attr') }}" class="citation-sources {{ className|default('') }}"><p class="citation-sources__text"></p><template data-prototype="marker"><span class="citation-sources__marker"><button type="button" class="citation-sources__button"></button><span role="tooltip" class="citation-sources__tooltip"><span data-title class="citation-sources__tooltip-title"></span><span data-host class="citation-sources__tooltip-host"></span></span></span></template><template data-prototype="list"><ol class="citation-sources__list"></ol></template><template data-prototype="footnote"><li class="citation-sources__footnote"><span data-index class="citation-sources__index"></span><span class="citation-sources__body"><span data-title class="citation-sources__title"></span><span data-host class="citation-sources__host"></span></span></li></template></div>
