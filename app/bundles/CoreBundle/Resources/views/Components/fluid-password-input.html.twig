{% set id = id|default(name|default('input')|replace({'[': '-', ']': '', ' ': '-', '.': '-'})) %}
{% set invalid = invalid|default(false) %}
{% set describedby = describedby|default([]) %}
{% set control %}
    {% include '@MauticCore/Components/form-control.html.twig' with {
        id: id,
        name: name|default('input'),
        type: 'password',
        label: null,
        value: value|default(''),
        placeholder: placeholder|default(null),
        disabled: disabled|default(false),
        readonly: readonly|default(false),
        required: required|default(false),
        describedby: describedby,
        render_feedback: false,
        wrapperClass: '',
        attributes: invalid ? (attributes|default({})|merge({'aria-invalid': 'true', class: (attributes.class|default('') ~ ' is-invalid')|trim})) : attributes|default({}),
        validation: validation|default({})
    } only %}
{% endset %}
{% set extra %}
    <button type="button" class="form-fluid__password-toggle" aria-label="{{ showPasswordLabel|default('mautic.marketplace.forms.field.show_password')|trans }}" data-label-show="{{ showPasswordLabel|default('mautic.marketplace.forms.field.show_password')|trans }}" data-label-hide="{{ hidePasswordLabel|default('mautic.marketplace.forms.field.hide_password')|trans }}" aria-pressed="false">
        <i class="ri-eye-line" aria-hidden="true"></i>
    </button>
{% endset %}
{% include '@MauticCore/Components/fluid-field.html.twig' with _context|merge({control: control, extra: extra, modifier: 'password'}) only %}
