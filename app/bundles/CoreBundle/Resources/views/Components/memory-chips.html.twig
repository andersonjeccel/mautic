{% set labels = {title:'Assistant memory'|trans,saved:'saved'|trans,empty:'Nothing saved yet — the assistant remembers facts you confirm.'|trans,forget:'Forget: %fact%'|trans,add:'Add'|trans} %}{% set options = {memories:memories,variant:variant is defined?variant:'Panel',title:title is defined?title:labels.title,className:className|default(''),hasAdd:onAdd|default(hasAdd|default(false))} %}<div data-component="memory-chips" data-options="{{ options|json_encode|escape('html_attr') }}" data-labels="{{ labels|json_encode|escape('html_attr') }}" class="memory-chips {{ className|default('') }}"><template data-prototype="header"><div class="memory-chips__header"><span class="memory-chips__heading"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="memory-chips__brain"><path d="M12 5a3 3 0 1 0-5.997.125 4 4 0 0 0-2.526 5.77 4 4 0 0 0 .556 6.588A4 4 0 1 0 12 18Z"/><path d="M12 5a3 3 0 1 1 5.997.125 4 4 0 0 1 2.526 5.77 4 4 0 0 1-.556 6.588A4 4 0 1 1 12 18Z"/><path d="M15 13a4.5 4.5 0 0 1-3-4 4.5 4.5 0 0 1-3 4"/><path d="M17.599 6.5a3 3 0 0 0 .399-1.375"/><path d="M6.003 5.125A3 3 0 0 0 6.401 6.5"/><path d="M3.477 10.896a4 4 0 0 1 .585-.396"/><path d="M19.938 10.5a4 4 0 0 1 .585.396"/><path d="M6 18a4 4 0 0 1-1.967-.516"/><path d="M19.967 17.484A4 4 0 0 1 18 18"/></svg><h3 data-title class="memory-chips__title"></h3></span><span data-count class="memory-chips__count"></span></div></template><template data-prototype="list"><ul class="memory-chips__list"></ul></template><template data-prototype="chip"><li class="memory-chips__item"><span class="memory-chips__fact"><button data-remove type="button" class="memory-chips__remove"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" 