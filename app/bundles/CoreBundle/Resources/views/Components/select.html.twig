{% set name = name|default('select') %}
{% set id = id|default(name|replace({'[': '-', ']': '', ' ': '-', '.': '-'})) %}
{% set label = label|default(null) %}
{% set labelPosition = labelPosition|default('top') %}
{% set options = options|default([]) %}
{% set value = value|default(null) %}
{% set helpText = helpText|default(null) %}
{% set help_id = help_id|default(helpText ? id ~ '-help' : null) %}
{% set size = size|default(null) %}
{% set disabled = disabled|default(false) %}
{% set required = required|default(false) %}
{% set multiple = multiple|default(false) %}
{% set wrapperClass = wrapperClass|default('') %}
{% set describedby = describedby|default([]) %}
{% set attributes = attributes|default({}) %}
{% set icon = icon|default(null) %}
{% set select_class = 'form-select' %}
{% set common_label_html %}
    {% if label %}
    <label for="{{ id }}" class="form-label">
        {% if icon %}
        <i class="{{ icon }} me-4" aria-hidden="true"></i>
    {% endif %}
        {{ required ? 'mautic.marketplace.forms.field.required'|trans({'%fieldLabel%': label|trans}) : label|trans }}
    </label>
    {% endif %}
{% endset %}

{% if size in ['sm', 'lg'] %}
    {% set select_class = select_class ~ ' form-select-' ~ size %}
{% endif %}

{% if attributes.class is defined %}
    {% set select_class = select_class ~ ' ' ~ attributes.class %}
{% endif %}

{% if help_id %}
    {% set describedby = describedby|merge([help_id]) %}
{% endif %}

{% set describedby_default = describedby|join(' ') %}

{% if wrapperClass is defined and wrapperClass is not empty %}
<div class="{{ wrapperClass }}">
{% endif %}

    {% if labelPosition == 'top' %}
        {{ common_label_html }}
    {% endif %}

    <select
        class="{{ select_class|trim }}"
        id="{{ id }}"
        name="{{ name }}"
        {% if describedby is not empty %}aria-describedby="{{ describedby|join(' ') }}"{% endif %}
        {% if disabled %}disabled{% endif %}
        {% if required %}required{% endif %}
        {% if multiple %}multiple{% endif %}
        {% for attribute, attribute_value in attributes %}
            {% if attribute != 'class' %}
                {{ attribute }}="{{ attribute_value }}"
            {% endif %}
        {% endfor %}
    >
        {% if placeholder is defined %}
            {% if placeholder is same as(null) %}
            <option value="" hidden {% if value is same as(null) or value == '' %}selected{% endif %}></option>
            {% else %}
            <option value="" {% if value is same as(null) or value == '' %}selected{% endif %}>{{ placeholder|trans }}</option>
            {% endif %}
        {% endif %}
        {% for option in options %}
            {% set option_value = option.value|default('') %}
            {% set selected = multiple ? option_value in (value|default([])) : option_value == value %}
            <option
                value="{{ option_value }}"
                {% if selected %}selected{% endif %}
                {% if option.disabled|default(false) %}disabled{% endif %}
            >
                {{ option.label|default('')|trans }}
            </option>
        {% endfor %}
    </select>

    {% if labelPosition == 'bottom' %}
        {{ common_label_html }}
    {% endif %}

    {% if helpText %}
        <div id="{{ help_id }}" class="form-text">{{ helpText|trans }}</div>
    {% endif %}
{% if wrapperClass is defined and wrapperClass is not empty %}
</div>
{% endif %}
