{% set label = label is defined ? label : 'Assistant is thinking'|trans %}{% set variant = variant is defined ? variant : 'Dots' %}<div data-component="thinking-dots" data-variant="{{ variant }}" data-default-label="{{ 'Assistant is thinking'|trans }}" data-class-name="{{ className|default('') }}" role="status" aria-label="{{ label }}" class="thinking-dots {{ className|default('') }}"><span data-indicator aria-hidden="true" class="{{ variant == 'Dots' ? 'thinking-dots__dots' : 'thinking-dots__track' }}">{% if variant == 'Dots' %}{% for index in 0..2 %}<span class="thinking-dots__dot" style="animation:core-thinking-dot 1.2s ease-in-out {{ index * 160 }}ms infinite"></span>{% endfor %}{% else %}<span class="thinking-dots__bar" style="animation:core-thinking-bar 1.1s ease-in-out infinite"></span>{% endif %}</span><span data-label class="thinking-dots__label">{{ label }}</span></div>
