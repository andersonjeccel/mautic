<div data-slot="card-description" class="acervo-card__description {{ className|default('') }}"{% for key, value in attributes|default({}) %}{% if key matches '/^[a-zA-Z_:][a-zA-Z0-9_.:-]*$/' and key not in ['class','data-slot'] and value is not same as(null) and (key not in ['hidden','inert'] or value is not same as(false)) %} {{ key }}="{{ key in ['hidden','inert'] ? '' : (value is same as(true) ? 'true' : (value is same as(false) ? 'false' : value)) }}"{% endif %}{% endfor %}>{% block card_description %}{% if children is defined and children is not same as(true) and children is not same as(false) %}{% if children is same as(children ~ '') %}{{ children|trans }}{% else %}{{ children }}{% endif %}{% endif %}{% endblock %}</div>
