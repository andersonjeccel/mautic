<span aria-hidden="true" data-testid="voice-visualizer" class="voice-visualizer {{ className|default('') }}"><style>@keyframes su-eq { 0%, 100% { transform: scaleY(0.3) } 50% { transform: scaleY(1) } }</style>{% set count = barCount is defined ? barCount : 18 %}{% set animated = active is defined ? active : true %}{% for index in (0..17)|slice(0,count) %}<span class="voice-visualizer__bar {{ animated ? 'voice-visualizer__bar--active' : 'voice-visualizer__bar--inactive' }} {{ barClassName|default('') }}" style="height:{{ 8 + ((index * 53) % 12) }}px;{% if animated %}animation:su-eq {{ 640 + ((index * 131) % 420) }}ms ease-in-out {{ (index * 67) % 480 }}ms infinite;{% endif %}transform-origin:center"></span>{% endfor %}</span>
