{% set variant = variant is defined ? variant : 'Bar' %}<div data-component="usage-meter" data-usage="{{ usage|json_encode|escape('html_attr') }}" data-variant="{{ variant }}" data-class-name="{{ className|default('') }}" data-title="{{ 'Context window'|trans }}" data-meter-label="{{ 'Context window usage'|trans }}" data-breakdown-pattern="{{ 'prompt %prompt% %separator% completion %completion%'|trans }}" class="usage-meter {{ className|default('') }}">{% if variant == 'Inline' %}<span data-track aria-hidden="true" class="usage-meter__track"><span data-fill class="usage-meter__fill"></span></span><span data-summary></span>{% if usage.estimatedCostUsd is defined %}<span data-cost class="usage-meter__cost"></span>{% endif %}{% else %}<div class="usage-meter__header"><span class="usage-meter__title">{{ 'Context window'|trans }}</span><span data-summary class="usage-meter__summary"></span></div><div data-track role="meter" aria-valuemin="0" aria-valuemax="{{ usage.contextWindow }}" aria-valuenow="{{ usage.promptTokens + usage.completionTokens }}" aria-label="{{ 'Context window usage'|trans }}" class="usage-meter__track"><span data-fill class="usage-meter__fill"></span></div><div class="usage-meter__footer"><span data-breakdown></span>{% if usage.estimatedCostUsd is defined %}<span data-cost></span>{% endif %}</div>{% endif %}</div>
