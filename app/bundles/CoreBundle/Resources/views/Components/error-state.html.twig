{% import '@MauticCore/Components/error-state-icons.html.twig' as icons %}{% set variant = variant is defined ? variant : 'Card' %}{% set title = title is defined ? title : 'Generation failed'|trans %}{% set retryLabel = retryLabel is defined ? retryLabel : 'Retry'|trans %}<div data-component="error-state" data-variant="{{ variant }}" data-class-name="{{ className|default('') }}"{% if message is defined %} data-initial-message="{{ message }}"{% endif %} data-title-default="{{ 'Generation failed'|trans }}" data-message-default="{{ 'The model timed out before finishing. Your prompt is preserved %dash% retrying usually resolves this.'|trans }}" data-retry-label="{{ retryLabel }}" data-retry-label-default="{{ 'Retry'|trans }}" data-busy-label="{{ 'Retrying%ellipsis%'|trans }}"{% if retrying is defined %} data-retrying="{{ retrying ? 'true' : 'false' }}"{% endif %} role="alert" class="error-state {{ className|default('') }}">{% if variant == 'Inline' %}{{ icons.icon('alert',false) }}<span data-title>{{ title }}</span>{% else %}<div class="error-state__header"><span class="error-state__badge">{{ icons.icon('alert',false) }}</span><div class="error-state__copy"><h3 data-title>{{ title }}</h3><p data-message>{% if message is defined %}{{ message }}{% else %}{{ 'The model timed out before finishing. Your prompt is preserved %dash% retrying usually resolves this.'|trans({'%dash%':'%dash%'})|split('%dash%')|first }}&#8212;{{ 'The model timed out before finishing. Your prompt is preserved %dash% retrying usually resolves this.'|trans|split('%dash%')|last }}{% endif %}</p></div></div><div class="error-state__actions">{% endif %}<button data-retry type="button" class="error-state__retry"{% if retrying|default(false) %} disabled{% endif %}>{{ icons.icon(retrying|default(false) ? 'loader' : 'refresh',true) }}{% if retrying|default(false) and variant != 'Inline' %}{{ 'Retrying'|trans }}&#8230;{% else %}{{ retryLabel }}{% endif %}</button>{% if variant != 'Inline' %}</div>{% endif %}</div>
