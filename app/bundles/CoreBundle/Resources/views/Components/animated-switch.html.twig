{% set size = size|default('md') %}
{% set dimensions = {sm: [32, 18, 8], md: [44, 24, 10], lg: [56, 30, 12]}[size] %}
{% set state = checked is defined and checked is not same as(null) ? checked : defaultChecked|default(false) %}
<button type="button" role="switch" data-component="animated-switch" data-size="{{ size }}" data-default-checked="{{ defaultChecked|default(false) ? 'true' : 'false' }}" data-controlled="{{ checked is defined ? 'true' : 'false' }}" data-checked="{{ state ? 'true' : 'false' }}" aria-checked="{{ state ? 'true' : 'false' }}" aria-label="{{ (label is defined ? label : 'mautic.core.animated_switch.toggle')|trans }}" class="animated-switch {{ className|default('') }}" style="width:{{ dimensions[0] }}px;height:{{ dimensions[1] }}px"{% if disabled|default(false) %} disabled{% endif %}>
  <span aria-hidden="true" class="animated-switch__hit"></span>
  <span aria-hidden="true" class="animated-switch__knob" data-switch-knob style="width:{{ dimensions[1] - 4 }}px;height:{{ dimensions[1] - 4 }}px;transform:{{ state ? 'translateX(' ~ (dimensions[0] - dimensions[1]) ~ 'px)' : 'none' }}">{% if (onIcon is defined and onIcon is not same as(null)) or (offIcon is defined and offIcon is not same as(null)) %}<span class="animated-switch__icons">{% set activeIcon = state ? (onIcon is defined ? onIcon : null) : (offIcon is defined ? offIcon : null) %}{% if activeIcon is not same as(null) %}<span class="animated-switch__icon" data-icon-key="{{ state ? 'on' : 'off' }}" style="width:{{ dimensions[2] }}px;height:{{ dimensions[2] }}px;font-size:{{ dimensions[2] }}px;line-height:1;opacity:1;transform:none">{% if activeIcon is not same as(true) and activeIcon is not same as(false) %}{{ activeIcon }}{% endif %}</span>{% endif %}</span>{% endif %}</span>
  {% if onIcon is defined and onIcon is not same as(null) %}<template data-icon-on>{% if onIcon is not same as(true) and onIcon is not same as(false) %}{{ onIcon }}{% endif %}</template>{% endif %}
  {% if offIcon is defined and offIcon is not same as(null) %}<template data-icon-off>{% if offIcon is not same as(true) and offIcon is not same as(false) %}{{ offIcon }}{% endif %}</template>{% endif %}
</button>
