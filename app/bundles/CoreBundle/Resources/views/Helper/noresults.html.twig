{% set header = header is defined ? header : 'mautic.core.noresults.header' %}
{% set message = message is defined ? message : 'mautic.core.noresults' %}
<div class="alert alert-warning col-md-6 offset-md-3 mt-md" style="white-space: normal;">
    <h4>{{ header|trans }}</h4>
    <p>{{ message|trans }}</p>
</div>

{% if tip is defined %}
    <div class="card card-body card card-body col-md-6 offset-md-3">
        <div class="row">
            <div class="mautibot-image col-3 text-center">
                <img class="img-fluid" style="max-height: 125px; margin-left: auto; margin-right: auto;" src="{{ mautibotGetImage('wave') }}" />
            </div>
            <div class="col-9">
                <h4><i class="ri-double-quotes-l"></i> {% trans %}mautic.core.noresults.tip{% endtrans %} <i class="ri-double-quotes-r"></i></h4>
                <p class="mt-md">{{ tip|trans }}</p>
            </div>
        </div>
    </div>
{% endif %}
