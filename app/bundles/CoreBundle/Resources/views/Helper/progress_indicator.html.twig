{% set errorIcon %}
<svg focusable="false" preserveAspectRatio="xMidYMid meet" fill="currentColor" width="16"
                height="16" viewBox="0 0 16 16" aria-hidden="true" class="progress-indicator__warning"
                xmlns="http://www.w3.org/2000/svg">
                <path
                    d="M8,1C4.1,1,1,4.1,1,8s3.1,7,7,7s7-3.1,7-7S11.9,1,8,1z M8,14c-3.3,0-6-2.7-6-6s2.7-6,6-6s6,2.7,6,6S11.3,14,8,14z">
                </path>
                <path d="M7.5 4H8.5V9H7.5z"></path>
                <path d="M8,10.2c-0.4,0-0.8,0.3-0.8,0.8s0.3,0.8,0.8,0.8c0.4,0,0.8-0.3,0.8-0.8S8.4,10.2,8,10.2z"></path>
            </svg>
{% endset %}

<!-- Status icons map -->
{% set statusIcons = {
'complete': completeIcon,
'current': currentIcon,
'incomplete': incompleteIcon,
'disabled': incompleteIcon,
'error': errorIcon
} %}

<!-- Status classes map -->
{% set statusClasses = {
'complete': 'progress-indicator-step--complete',
'current': 'progress-indicator-step--current',
'incomplete': 'progress-indicator-step--incomplete',
'disabled': 'progress-indicator-step--incomplete progress-indicator-step--disabled',
'error': 'progress-indicator-step--incomplete'
} %}

<!-- Status assistive text map -->
{% set statusAssistiveText = {
'complete': 'mautic.core.progress_indicator.assistive.complete',
'current': 'mautic.core.progress_indicator.assistive.current',
'incomplete': 'mautic.core.progress_indicator.assistive.incomplete',
'disabled': 'mautic.core.progress_indicator.assistive.incomplete',
'error': 'mautic.core.progress_indicator.assistive.error'
} %}

<ul class="progress-indicator {% if spaceEqually is defined and spaceEqually %}progress-indicator--space-equal{% endif %} {% if vertical is defined and vertical %}progress-indicator--vertical{% endif %}"{% if stepper is defined and stepper %} data-stepper-indicator{% endif %}{% if ariaLabel is defined %} aria-label="{{ ariaLabel }}"{% endif %}>
    {% if stepper is defined and stepper %}
    {% for status, icon in statusIcons %}
    <template data-status="{{ status }}" data-class="{{ statusClasses[status] }}" data-assistive="{{ statusAssistiveText[status]|trans }}">{{ icon }}</template>
    {% endfor %}
    {% endif %}
    {% for step in steps %}
    {% set step_clickable = step.status != 'current' and step.status != 'disabled' %}
    <li class="progress-indicator-step {{ statusClasses[step.status] }}">
        <button type="button" class="progress-indicator-step-button {{ step_clickable ? '' : 'progress-indicator-step-button--unclickable' }}"
            tabindex="{{ step.status == 'disabled' ? '-1' : '0' }}" title="{{ step.label|trans }}" index="{{ loop.index }}"{% if step_clickable %} data-wizard-goto="{{ loop.index }}"{% endif %}{% if step.status == 'disabled' %} disabled aria-disabled="true"{% endif %}>
            {{ statusIcons[step.status] }}
            <div class="progress-indicator-text">
                <span class="progress-indicator-label" dir="ltr">{{ step.label|trans }}</span>
                {% if step.secondaryLabel is defined and step.secondaryLabel is not empty %}
                    <span class="progress-indicator-optional" dir="ltr">{{ step.secondaryLabel|trans }}</span>
                {% endif %}
            </div>
            <span class="visually-hidden">{{ statusAssistiveText[step.status]|trans }}</span>
            <span class="progress-indicator-line"></span>
        </button>
    </li>
    {% endfor %}
</ul>