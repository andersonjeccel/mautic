{#
Ported from mautic-public-marketplace. Additions: stepper (let 17.stepper.js drive the
statuses), ariaLabel, translation keys.
spaceEqually: true, false
vertical: true, false
steps: [
status: complete, current, incomplete, disabled, error
active: true, false
label: string
secondaryLabel: string
]
#}

