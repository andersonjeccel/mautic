{% extends app.request.xmlHttpRequest ? '@MauticCore/Default/content.html.twig' : '@MauticUser/Security/base.html.twig' %}
{% block header %}{% trans %}mautic.user.auth.header{% endtrans %}{% endblock %}
{% block headerTitle %}{% trans %}mautic.user.auth.expired.header{% endtrans %}{% endblock %}

{% block content %}
    {% if app.request.xmlHttpRequest %}
        <div class="row">
            <div class="col-xs-12 col-sm-8 col-md-6 inline-login">
                {{ block('mainContent') }}
            </div>
        </div>
    {% else %}
        {{ block('mainContent') }}
    {% endif %}
{% endblock %}

{% block mainContent %}
	{% if not app.request.xmlHttpRequest %}
		<h1 class="type-heading-05 mb-32">{% trans %}mautic.user.auth.header{% endtrans %}</h1>
	{% endif %}
	<form class="login-form" name="login" data-toggle="ajax" role="form" action="{{ path('mautic_user_logincheck') }}" method="post" style="margin:0 -16px -16px;">
		{% include '@MauticCore/Components/fluid-text-input.html.twig' with {
			id: 'username',
			name: '_username',
			labelText: 'mautic.user.auth.form.loginusername',
			value: last_username|default(''),
			wrapperClass: 'form-group',
			attributes: {required: 'required', autofocus: 'autofocus'}
		} only %}
		{% include '@MauticCore/Components/fluid-password-input.html.twig' with {
			id: 'password',
			name: '_password',
			labelText: 'mautic.core.password',
			wrapperClass: 'form-group mb-24',
			link: {href: path('mautic_user_passwordreset'), label: 'mautic.user.user.passwordreset.link'},
			attributes: {required: 'required'}
		} only %}

		<div class="checkbox-inline custom-primary" style="margin-left:16px;">
			<label for="remember_me">
				<input type="checkbox" id="remember_me" name="_remember_me"/>
				<span></span>
				{% trans %}mautic.user.auth.form.rememberme{% endtrans %}
			</label>
		</div>

		<input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate')|escape }}"/>
		<div class="mt-32">
			{% include '@MauticCore/Helper/button.html.twig' with {
				buttons: [{
					label: 'mautic.user.auth.form.loginbtn',
					variant: 'primary',
					size: 'xl',
					wide: true,
					icon: 'ri-arrow-right-line',
					attributes: {type: 'submit', id: 'form-loginbtn'}
				}]
			} only %}
		</div>
	</form>
	{% if integrations is not empty %}
		<ul class="list-group">
			{% for sso in integrations %}
				<a href="{{ path('mautic_sso_login', {'integration' : sso.getName()}) }}" class="list-group-item">
					<img class="pull-left mr-xs" style="height: 16px;" src="{{ getAssetUrl(sso.getIcon()) }}">
					<p class="list-group-item-heading">{{ ('mautic.integration.sso.' ~ sso.getName())|trans }}</p>
				</a>
			{% endfor %}
		</ul>
	{% endif %}
{% endblock %}
