{% extends app.request.xmlHttpRequest ? '@MauticCore/Default/content.html.twig' : '@MauticUser/Security/base.html.twig' %}
{% block header %}{% trans %}mautic.user.auth.header{% endtrans %}{% endblock %}
{% block headerTitle %}{% trans %}mautic.user.auth.expired.header{% endtrans %}{% endblock %}

{% block content %}
    {% if app.request.xmlHttpRequest %}
        <div class="row">
            <div class="col-xs-12 col-sm-8 col-md-6 inline-login">
                {{ block('mainContent') }}
            </div>
        </div>
    {% else %}
        {{ block('mainContent') }}
    {% endif %}
{% endblock %}

{% block mainContent %}
	{% if not app.request.xmlHttpRequest %}
	<div class="mb-32 ps-16 pe-16 pt-16">
		<h1 class="type-fluid-paragraph-01">{% trans %}mautic.user.auth.header{% endtrans %}</h1>
		<span class="text-secondary type-helper-text-01">Need help? Contact your administrator.</span>
	</div>
	{% endif %}
	<form class="login-form bdr-t" name="login" data-toggle="ajax" role="form" action="{{ path('mautic_user_logincheck') }}" method="post">
		{% include '@MauticCore/Components/text-input.html.twig' with {
			variant: 'fluid',
			id: 'username',
			name: '_username',
			labelText: 'mautic.user.auth.form.loginusername',
			value: last_username|default(''),
			wrapperClass: 'form-group',
			attributes: {required: 'required', autofocus: 'autofocus'}
		} only %}
		{% include '@MauticCore/Components/password-input.html.twig' with {
			variant: 'fluid',
			id: 'password',
			name: '_password',
			labelText: 'mautic.core.password',
			wrapperClass: 'form-group mb-16',
			link: {href: path('mautic_user_passwordreset'), label: 'mautic.user.user.passwordreset.link'},
			attributes: {required: 'required'}
		} only %}

		{# TEST-STATES-START #}
		{% include '@MauticCore/Components/text-input.html.twig' with {id: 'st-default', name: 'st_default', labelText: 'Default (empty)', wrapperClass: 'form-group'} only %}
		{% include '@MauticCore/Components/text-input.html.twig' with {id: 'st-value', name: 'st_value', labelText: 'Filled', value: 'Some value', wrapperClass: 'form-group'} only %}
		{% include '@MauticCore/Components/text-input.html.twig' with {id: 'st-placeholder', name: 'st_placeholder', labelText: 'Label + placeholder', placeholder: 'Example text', wrapperClass: 'form-group'} only %}
		{% include '@MauticCore/Components/text-input.html.twig' with {id: 'st-help', name: 'st_help', labelText: 'With helper', value: 'x', helpText: 'Helper text below the field', wrapperClass: 'form-group'} only %}
		{% include '@MauticCore/Components/text-input.html.twig' with {id: 'st-invalid', name: 'st_invalid', labelText: 'Invalid', value: 'bad value', invalid: true, invalidText: 'Enter a valid value.', helpText: 'Helper hidden while invalid', wrapperClass: 'form-group'} only %}
		{% include '@MauticCore/Components/text-input.html.twig' with {id: 'st-warn', name: 'st_warn', labelText: 'Warn', value: 'x', warnText: 'Check this value.', wrapperClass: 'form-group'} only %}
		{% include '@MauticCore/Components/text-input.html.twig' with {id: 'st-disabled', name: 'st_disabled', labelText: 'Disabled', value: 'off', disabled: true, wrapperClass: 'form-group'} only %}
		{% include '@MauticCore/Components/text-input.html.twig' with {id: 'st-readonly', name: 'st_readonly', labelText: 'Read only', value: 'fixed', readonly: true, wrapperClass: 'form-group'} only %}
		{% include '@MauticCore/Components/text-input.html.twig' with {id: 'st-link', name: 'st_link', labelText: 'With link', value: 'x', link: {href: '#', label: 'Example link'}, wrapperClass: 'form-group'} only %}
		{% include '@MauticCore/Components/text-area.html.twig' with {id: 'v-textarea', name: 'v_textarea', labelText: 'Text area', value: 'Some text', wrapperClass: 'form-group'} only %}
		{% include '@MauticCore/Components/select.html.twig' with {id: 'v-select', name: 'v_select', label: 'Select', value: 'b', options: [{value: 'a', label: 'Option A'}, {value: 'b', label: 'Option B'}], wrapperClass: 'form-group'} only %}
		{% include '@MauticCore/Components/select.html.twig' with {id: 'v-select-invalid', name: 'v_select_invalid', label: 'Select invalid', value: 'b', options: [{value: 'a', label: 'Option A'}, {value: 'b', label: 'Option B'}], invalid: true, invalidText: 'Pick a valid option.', wrapperClass: 'form-group'} only %}
		{% include '@MauticCore/Components/search-input.html.twig' with {id: 'v-search', name: 'v_search', labelText: 'Search', placeholder: 'Type to search', value: 'term', helpText: 'Search helper', wrapperClass: 'form-group'} only %}
		{% include '@MauticCore/Components/number-input.html.twig' with {id: 'v-number', name: 'v_number', labelText: 'Number', value: '42', min: 0, max: 100, step: 10, toggletipText: 'Use the buttons or type a value.', helpText: 'Number helper', wrapperClass: 'form-group'} only %}
		{% include '@MauticCore/Components/password-input.html.twig' with {id: 'v-password', name: 'v_password', labelText: 'Password variant', value: 'secret', helpText: 'Password helper', wrapperClass: 'form-group'} only %}
		{% include '@MauticCore/Components/search-input.html.twig' with {id: 'v-search-f', name: 'v_search_f', variant: 'fluid', labelText: 'Search fluid', placeholder: 'Type to search', value: 'term', helpText: 'Search helper', wrapperClass: 'form-group'} only %}
		{% include '@MauticCore/Components/number-input.html.twig' with {id: 'v-number-f', name: 'v_number_f', variant: 'fluid', labelText: 'Number fluid', value: '42', min: 0, max: 100, step: 10, toggletipText: 'Use the buttons or type a value.', helpText: 'Number helper', wrapperClass: 'form-group'} only %}
		{# TEST-STATES-END #}

		<div class="checkbox-inline custom-primary ms-16">
			<label for="remember_me">
				<input type="checkbox" id="remember_me" name="_remember_me"/>
				<span></span>
				{% trans %}mautic.user.auth.form.rememberme{% endtrans %}
			</label>
		</div>

		<input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate')|escape }}"/>
		<div class="mt-24 row-no-gutters justify-content-end">
			<div class="col-xs-6">
				{% include '@MauticCore/Helper/button.html.twig' with {
					buttons: [{
						label: 'mautic.user.auth.form.loginbtn',
						variant: 'primary',
						size: 'xl',
						wide: true,
						icon: 'ri-arrow-right-line',
						attributes: {type: 'submit', id: 'form-loginbtn'}
					}]
				} only %}
			</div>
		</div>
	</form>
	{% if integrations is not empty %}
		<ul class="list-group">
			{% for sso in integrations %}
				<a href="{{ path('mautic_sso_login', {'integration' : sso.getName()}) }}" class="list-group-item">
					<img class="pull-left mr-xs" style="height: 16px;" src="{{ getAssetUrl(sso.getIcon()) }}">
					<p class="list-group-item-heading">{{ ('mautic.integration.sso.' ~ sso.getName())|trans }}</p>
				</a>
			{% endfor %}
		</ul>
	{% endif %}
{% endblock %}
