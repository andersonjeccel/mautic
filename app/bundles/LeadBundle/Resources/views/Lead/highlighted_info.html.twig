<div class="tile mb-lg">
    <div class="d-flex fd-column fd-row-lg ai-center-lg">
        {% for item in items %}
            {% set isEven = loop.index0 % 2 == 0 %}
            {% set isOdd = loop.index0 % 2 == 1 %}
            {% set isLast = loop.last %}
            
            {% if isEven %}
                <div class="d-flex fg-1">
                    <div class="d-flex fd-column fg-1 fd-row-sm ai-center-lg">
            {% endif %}
            
            <div class="col-sm-6 col-xs-12 ai-start gap-sm">
                <div class="d-flex ai-center type-label-01 text-secondary mb-xs">
                    {% if item.renderIcon %}
                        <i class="{{ item.renderIcon }} mr-3 type-label-02"></i>
                    {% endif %}
                    {{ item.label }}
                </div>
                <div class="type-fluid-paragraph-01"{% if item.highlightTooltip is defined %} data-toggle="tooltip" title="{{ item.highlightTooltip }}"{% endif %}>{{ item.highlight }}</div>
            </div>
            
            {% if isOdd or isLast %}
                    </div>
                </div>
            {% endif %}
            
            {% if not isLast %}
                <div class="v-divider{% if isOdd %} v-divider-lg{% else %} v-divider-sm{% endif %}"></div>
            {% endif %}
        {% endfor %}
    </div>
</div>