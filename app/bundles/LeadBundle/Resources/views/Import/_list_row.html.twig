{#
  Variables
    - item: Item to render
    - actionRoute
#}
{% set objectRoute = null %}
{% if 'lead' == item.object %}
  {% set objectRoute = 'mautic_contact_index' %}
{% endif %}
<tr>
    <td class="col-actions text-center">
        <span class="badge label-{{ item.satusLabelClass }}">
            {{ ('mautic.lead.import.status.'~item.status)|trans }}
        </span>
    </td>
    <td>
        <div>
            {% if item.status not in [constant('FAILED', item), constant('IMPORTED', item), constant('MANUAL', item)] and permissions[permissionBase~':publish'] %}
              {{ include('@MauticCore/Helper/publishstatus_icon.html.twig', {'item': item, 'model': 'lead.import'}) }}
            {% endif %}
            {% if securityHasEntityAccess(true, permissions[permissionBase~':viewother'], item.createdBy) %}
              <a href="{{ path(actionRoute, {'objectAction': 'view', 'objectId': item.id, 'object': app.request.get('object', 'contacts')}) }}" data-toggle="ajax">
                {{ item.name }}
              </a>
            {% else %}
              {{ item.name }}
            {% endif %}
        </div>
    </td>
    <td class="d-none d-md-table-cell">{% if item.runTime %}{{ dateFormatRange(item.runTime) }}{% endif %}</td>
    <td class="d-none d-md-table-cell">{{ item.progressPercentage }}%</td>
    <td class="d-none d-md-table-cell">
        {% if objectRoute is not null %}
            <a size="sm" class="mt-xs badge label-gray" href="{{ path(objectRoute, {'search': 'mautic.lead.lead.searchcommand.import_id'|trans~':'~item.id}) }}">{{ item.lineCount }}</a>
        {% else %}
            {{ item.lineCount }}
        {% endif %}
    </td>
    <td class="d-none d-md-table-cell">
        {% if objectRoute is not null %}
            <a size="sm" class="mt-xs badge label-gray" href="{{ path(objectRoute, {'search': 'mautic.lead.lead.searchcommand.import_id'|trans~':'~item.id~' '~'mautic.lead.lead.searchcommand.import_action'|trans~':inserted'}) }}">{{ item.insertedCount }}</a>
        {% else %}
            {{ item.insertedCount }}
        {% endif %}
    </td>
    <td class="d-none d-md-table-cell">
        {% if objectRoute is not null %}
            <a size="sm" class="mt-xs badge label-gray" href="{{ path(objectRoute, {'search': 'mautic.lead.lead.searchcommand.import_id'|trans~':'~item.id~' '~'mautic.lead.lead.searchcommand.import_action'|trans~':updated'}) }}">{{ item.updatedCount }}</a>
        {% else %}
            {{ item.updatedCount }}
        {% endif %}
    </td>
    <td class="d-none d-md-table-cell">{{ item.ignoredCount }}</td>
    <td class="d-none d-md-table-cell">{{ item.createdByUser }}</td>
    <td class="d-none d-md-table-cell">
        <abbr title="{{ dateToFull(item.dateAdded) }}">
            {{ dateToText(item.dateAdded) }}
        </abbr>
    </td>
    <td class="d-none d-md-table-cell">{{ item.id }}</td>
</tr>
