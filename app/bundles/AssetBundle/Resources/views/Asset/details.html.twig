{% extends '@MauticCore/Default/content.html.twig' %}
{% block mauticContent %}asset{% endblock %}
{% block indexButton %}
{{- include('@MauticCore/Helper/page_actions.html.twig',
        {
            'item'            : activeAsset,
            'templateButtons' : {
                'close' : securityHasEntityAccess(
                    permissions['asset:assets:viewown'],
                    permissions['asset:assets:viewother'],
                    activeAsset.getCreatedBy()
                ),
            },
            'routeBase'  : 'asset',
            'langVar'    : 'asset.asset',
            'nameGetter' : 'getTitle',
            'targetLabel': 'mautic.asset.assets'|trans
        }
    ) -}}
{% endblock %}

{% block headerTitle %} {{ activeAsset.getTitle() }} {% endblock %}

{% block actions %}
{{- include('@MauticCore/Helper/page_actions.html.twig',
        {
            'item'            : activeAsset,
            'templateButtons' : {
                'edit' : securityHasEntityAccess(
                    permissions['asset:assets:editown'],
                    permissions['asset:assets:editother'],
                    activeAsset.getCreatedBy()
                ),
                'clone'  : permissions['asset:assets:create'],
                'delete' : securityHasEntityAccess(
                    permissions['asset:assets:deleteown'],
                    permissions['asset:assets:deleteother'],
                    activeAsset.getCreatedBy()
                ),
            },
            'routeBase'  : 'asset',
            'langVar'    : 'asset.asset',
            'nameGetter' : 'getTitle',
}) -}}
{% endblock %}

{% block publishStatus %}
    {{- include('@MauticCore/Helper/publishstatus_badge.html.twig', {
        'entity': activeAsset,
        'status': 'available'
    }) -}}
{% endblock %}

{% block content %}

<!-- asset detail header -->
{% include '@MauticCore/Helper/description.html.twig' with {'description': activeAsset.description} %}
<!--/ asset detail header -->

{% include '@MauticCore/Helper/nav_tabs.html.twig' with {
    'tabs': [
        {
            'title': 'mautic.core.overview',
            'content': include('@MauticAsset/Asset/Details/details--tab_overview.html.twig')
        },
        {
            'title': 'mautic.core.details',
            'content': include('@MauticAsset/Asset/Details/details--tab_details.html.twig')
        }
    ],
    'style': 'line'
} %}

{% endblock %}